                        # # PROJECTILES - BULLET SPRITES # #

  # Indices for bulletSprite entries are commented on the right side;
  ## The corresponding file ID is the Indice value * 35, as bulletsprites contain/render 35 separate images.
  ### For example the file ID for gorechildthrow2.png is 24 x 35, equaling 840.

  - type: Projectiles
    width: 105
    height: 3
    subX: 3
    subY: 3
    files:
      840: Resources/gorechild/gorechildthrow2.png  # 24
