    #resetRank - use this for promoting handmaidens to sisters immaculate.


  - name: STR_INDUCT_LAY_BROTHER
    requires:
      - STR_OUR_DEVOTION_DEEPENS # Placeholder. Change later.
    cost: 10000
    producedSoldierType: STR_SLAANESHPATH_LAY_BROTHER
    keepSoldierArmor: false
    allowsDeadSoldiers: false
    allowsLiveSoldiers: true
    allowsWoundedSoldiers: true
