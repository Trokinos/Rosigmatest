items:

 #### BLACK MARKET AMMO ####
  - &BM_BOLTER_AMMO_TEMPLATE
    type: STR_CANTUS_BOLTER_AMMO_BM  # Low-grade, unreliable light bolts bought at unreasonable prices.
    weight: 2
    bigSprite: 3230
    floorSprite: {mod: 40k, index: 2}
    handSprite: {mod: 40k, index: 464}
    hitSound: {mod: 40k, index: 708}
    hitAnimation: {mod: 40k, index: 26}
    explosionSpeed: 5
    battleType: 2
    armor: 30
    invWidth: 1
    invHeight: 2
    damageAlter:  # DA ILLEGAL PIRATE COPY BOLTER
      ToArmorPre: 0.15
      ArmorEffectiveness: 1.0 # worse
      ToArmor: 0.2
      ToHealth: 1.0 # worse
      ToStun: 0.4 # worse
      ToEnergy: 0.3
      ToWound: 0.3
      RandomWound: false
      RandomType: 2 # 50-150 spread. No weak hits
    power: 47 # Worse
    damageType: 1
    clipSize: 30
    tags:
      ITEM_AMMO_COLOR: 0
      ITEM_IS_PALETTE_SWAP: 1
      ITEM_GETS_ACCENT_RECOLOR: 1
      ITEM_BASE_COLOR: 14
      ITEM_ACCENT_COLOR: 1
      ITEM_SWAP_BASE_COLOR: 8
      ITEM_SWAP_ACCENT_COLOR: 6

  - type: STR_LIGHT_BOLTER_AMMO_BM
    refNode: *BM_BOLTER_AMMO_TEMPLATE
    power: 54
    costBuy: 2400
    costSell: 140
    hitAnimation:
      mod: 40k
      index: 120
    explosionSpeed: 3

  - type: STR_LIGHT_BOLTPISTOL_AMMO_BM
    refNode: *BM_BOLTER_AMMO_TEMPLATE
    bigSprite: {mod: 40k, index: 4}
    floorSprite: {mod: 40k, index: 4}
    handSprite: {mod: 40k, index: 464}
    power: 46
    costBuy: 2400
    costSell: 140
    hitAnimation:
      mod: 40k
      index: 120
    explosionSpeed: 3

 #### SLAANESH PLASMA AMMO ####

  - &STR_SLAANESHPATH_PLASMA_MUNITION_TEMPLATE
    type: STR_PLASMA_SPRAY_CLIP_SLAAN
    bigSprite: {mod: 40k, index: 34}
    floorSprite: {mod: 40k, index: 33}
    handSprite: {mod: 40k, index: 440}
    hitSound: {mod: 40k, index: 19}
    hitAnimation: 60
    power: 70 # Spraygun power
    damageType: 5
    damageAlter:  # DA PLASMA SLAAN
      RandomType: 2
      ToHealth: 0.5  # Slightly worse
      ArmorEffectiveness: 0.75
      ToArmorPre: 0.5  # Slaan melt
      ToArmor: 0.2
      ToEnergy: 0.2
      ToMorale: 0.25
      ToStun: 0.2 # Added
    powerRangeReduction: 5
    powerRangeThreshold: 20.0  # plasma decoheres at longer ranges
    vaporColorSurface: 17
    vaporDensitySurface: 6
    vaporProbabilitySurface: 18

    weight: 3
    clipSize: 12
    battleType: 2
    inventoryMoveCost: #quickdraw
      basePercent: 50

  - type: STR_PLASMA_RIFLE_CLIP_SLAAN
    refNode: *STR_SLAANESHPATH_PLASMA_MUNITION_TEMPLATE
    power: 100

 #### SLAANESH MELTA AMMO ####

  - type: STR_LIGHT_MELTA_AMMO_SLAAN  # Slaanesh variant of meltagun ammo.
    power: 10 # - 2 vs normal
    damageType: 11
    damageAlter:  # DA MELTA SLAN
      RandomType: 6
      ToArmorPre: 1.0
      ToHealth: 1.1 # - 0.5 vs normal
      ToTile: 6.5 # + 0.5 vs normal
      ToWound: 0.2 # +0.15 vs normal
      ToMorale: 0.2 # Slaanesh profile
      ToEnergy: 0.2 # Slaanesh profile
      RandomWound: false
      TileDamageMethod: 2
    shotgunBehavior: 1
    shotgunPellets: 6
    shotgunSpread: 0
    powerRangeReduction: 1.5 # Slightly worse than normal melta
    powerRangeThreshold: 8.0 #
    clipSize: 12 # +6

 #### SLAANESH LAS AMMO ####

  - &STR_SLAANESHPATH_LASGUN_MUNITION_STANDARD_TEMPLATE
    type: STR_SLAANESHPATH_LASGUN_CLIP_STANDARD
    categories: [STR_CAT_LASGUN, STR_CAT_SNIPER]
    requiresBuy: # Placeholder
      - STR_SLAANESHPATH
    size: 0.1
    costSell: 200
    weight: 1
    bigSprite: 2307
    floorSprite: {mod: 40k, index: 1021}
    handSprite: {mod: 40k, index: 1168}
    hitAnimation: 36
    power: 55
    damageType: 1 # AP, to be in line with rebalanced lasgun ammo
    damageAlter:  # LAS SLAANESH
      ToArmorPre: 0.30 # 0.2 -> 0.30
      ArmorEffectiveness: 0.9 # Penetrative power
      ToHealth: 0.7 # Worse at health damage.
      ToStun: 0.45 # 0.3 -> 0.35
      ToEnergy: 0.1 # Weakening
      ToMorale: 0.1 # Weakening
      ToTime: 0.1 # Weakening
    clipSize: 30 # Half the clip size of a normal lasgun clip.
    battleType: 2
    invWidth: 1
    invHeight: 1
    armor: 70
    listOrder: 11060
    # lasgun aesthetics
    hitSound: 3986
    fireSound: 3981
    bulletSprite: {mod: 40k, index: 22}
    vaporColorSurface: 17  # purple laser
    vaporDensitySurface: 1
    vaporProbabilitySurface: 100
    scripts:
      vaporParticleAmmo: |
        # noting
        set particle_lifetime 1;
        set subvoxel_drift 0;
        return;

  - &STR_SLAANESHPATH_LASGUN_MUNITION_TAINTED_TEMPLATE
    type: STR_SLAANESHPATH_LASGUN_CLIP_TAINTED
    categories: [STR_CAT_LASGUN, STR_CAT_SNIPER]
    requiresBuy: # Placeholder
      - STR_SLAANESHPATH
    size: 0.1
    costSell: 400
    weight: 1
    bigSprite: 2307
    floorSprite: {mod: 40k, index: 1021}
    handSprite: {mod: 40k, index: 1168}
    hitAnimation: 36
    power: 60 # +5
    damageType: 4
    damageAlter:  # LAS SLAANESH
      ToArmorPre: 0.5 # BIG armor damage!
      ArmorEffectiveness: 0.7 # HIGH Penetrative power!
      ToHealth: 0.30 # TERRIBLE health damage!
      ToStun: 0.35 # 0.3 -> 0.35
      ToEnergy: 0.25 # Weakening
      ToMorale: 0.25 # Weakening
      ToTime: 0.25 # Weakening
    clipSize: 15 # only 15 shots!
    battleType: 2
    invWidth: 1
    invHeight: 1
    armor: 70
    listOrder: 11060
    # lasgun aesthetics
    hitSound: 3986
    fireSound: 3981
    bulletSprite: {mod: 40k, index: 22}
    vaporColorSurface: 17  # purple laser
    vaporDensitySurface: 1
    vaporProbabilitySurface: 100
    scripts:
      vaporParticleAmmo: |
        # noting
        set particle_lifetime 1;
        set subvoxel_drift 0;
        return;
    tags: #Minor infection due to warp nature of ammo.
      INFECTION_DAMAGE_PERCENT: 15  # inflicts % of damage dealt as infection damage
      INFECTION_TYPE: 3  # the type of infection. Thus far: 1: Nurgle, 2: GSC, 3: Slaanesh 4: Tzeentch

  - type: STR_SLAANESHPATH_LASPISTOL_CLIP  # 4010
