extended:
  tagsFile: Ruleset/tags_ROSIGMA.rul 

items:

  - type: STR_SLAANESHPATH_LASCANNON_CLIP_SMALL  # LASCANNON CLIP
    power: 120 # Significantly less power per shot!
    damageAlter:  # DA SLAANESH LAS
      RandomType: 2  # 50-150
      ToArmorPre: 0.6 # Very good at armor stripping!
      ToHealth: 0.65 # Very bad at health damage!
      ToArmor: 0.3
      ToStun: 0.3
      ToMorale: 0.3
      ToTime: 0.3
      ToEnergy: 0.3 # Disabling and debilitating.
    clipSize: 6 # A lot more shots per cell.
    # lasgun aesthetics
    hitSound: 3986
    fireSound: 3984
    hitAnimation: 2230
    bulletSprite: {mod: 40k, index: 22}
    vaporColorSurface: 17  # purple laser
    vaporProbabilitySurface: 100
    scripts:
      vaporParticleAmmo: |
        # noting
        set particle_lifetime 1;
        set subvoxel_drift 0;
        return;

  - &STR_SLAANESHPATH_LASGUN_MUNITION_STANDARD_TEMPLATE
    type: STR_SLAANESHPATH_LASGUN_CLIP_STANDARD
    categories: [STR_CAT_LASGUN, STR_CAT_SNIPER]
    requiresBuy: # Placeholder
    - STR_SLAANESHPATH
    size: 0.1
    costSell: 200
    weight: 1
    bigSprite: 2307
    floorSprite: {mod: 40k, index: 1021}
    handSprite: {mod: 40k, index: 1168}
    hitAnimation: 36
    power: 55
    damageType: 1 # AP, to be in line with rebalanced lasgun ammo
    damageAlter:  # LAS SLAANESH
      ToArmorPre: 0.30 # 0.2 -> 0.30 
      ArmorEffectiveness: 0.9 # Penetrative power 
      ToHealth: 0.7 # Worse at health damage. 
      ToStun: 0.45 # 0.3 -> 0.35
      ToEnergy: 0.1 # Weakening
      ToMorale: 0.1 # Weakening
      toTime: 0.1 # Weakening
    clipSize: 30 # Half the clip size of a normal lasgun clip.
    battleType: 2
    invWidth: 1
    invHeight: 1
    armor: 70
    listOrder: 11060
    # lasgun aesthetics
    hitSound: 3986
    fireSound: 3981
    bulletSprite: {mod: 40k, index: 22}
    vaporColorSurface: 17  # purple laser
    vaporDensitySurface: 1
    vaporProbabilitySurface: 100
    scripts:
      vaporParticleAmmo: |
        # noting
        set particle_lifetime 1;
        set subvoxel_drift 0;
        return;

  - &STR_SLAANESHPATH_LASGUN_MUNITION_TAINTED_TEMPLATE
    type: STR_SLAANESHPATH_LASGUN_CLIP_TAINTED
    categories: [STR_CAT_LASGUN, STR_CAT_SNIPER]
    requiresBuy: # Placeholder
    - STR_SLAANESHPATH
    size: 0.1
    costSell: 400
    weight: 1
    bigSprite: 2307
    floorSprite: {mod: 40k, index: 1021}
    handSprite: {mod: 40k, index: 1168}
    hitAnimation: 36
    power: 60 # +5
    damageType: 4 # AP, to be in line with rebalanced lasgun ammo
    damageAlter:  # LAS SLAANESH
      ToArmorPre: 0.5 # BIG armor damage! 
      ArmorEffectiveness: 0.7 # HIGH Penetrative power! 
      ToHealth: 0.30 # TERRIBLE health damage! 
      ToStun: 0.35 # 0.3 -> 0.35
      ToEnergy: 0.25 # Weakening
      ToMorale: 0.25 # Weakening
      toTime: 0.25 # Weakening
    clipSize: 15 # only 15 shots!
    battleType: 2
    invWidth: 1
    invHeight: 1
    armor: 70
    listOrder: 11060
    # lasgun aesthetics
    hitSound: 3986
    fireSound: 3981
    bulletSprite: {mod: 40k, index: 22}
    vaporColorSurface: 17  # purple laser
    vaporDensitySurface: 1
    vaporProbabilitySurface: 100
    scripts:
      vaporParticleAmmo: |
        # noting
        set particle_lifetime 1;
        set subvoxel_drift 0;
        return;
    tags: #Minor infection due to warp nature of ammo.
      INFECTION_DAMAGE_PERCENT: 25  # inflicts % of damage dealt as infection damage
      INFECTION_TYPE: 3  # the type of infection. Thus far: 1: Nurgle, 2: GSC, 3: Slaanesh 4: Tzeentch

 #### Standard laslock ammo: intended to strike a balance between damage and armor damage.

  - type: STR_SLAANESHPATH_LASLOCK_PISTOL_CLIP_STANDARD
    refNode: *STR_SLAANESHPATH_LASGUN_MUNITION_STANDARD_TEMPLATE
    fireSound: 3985
    power: 95
    damageType: 4 # AP, to be in line with rebalanced lasgun ammo
    damageAlter:  # Da Slaanesh Handcannon
      ToArmorPre: 0.55 # 0.2 -> 0.30 
      ArmorEffectiveness: 0.7 # Penetrative power
      toArmor: 0.2 # Ruins armor 
      ToHealth: 0.7 # Worse at health damage. 
      ToStun: 0.65
      ToEnergy: 0.35 # Weakening
      ToMorale: 0.35 # Weakening
      toTime: 0.35 # Weakening
    clipSize: 1 # You only get one shot.

    type: STR_SLAANESHPATH_LASLOCK_PISTOL_CLIP_TAINTED
    refNode: *STR_SLAANESHPATH_LASGUN_MUNITION_TAINTED_TEMPLATE
    fireSound: 3985
    power: 100
    damageType: 4 # AP, to be in line with rebalanced lasgun ammo
    damageAlter:  # Da Slaanesh CURSED handcannon
      ToArmorPre: 1 # Melta equivalent 
      ArmorEffectiveness: 0.7 # Penetrative power
      toArmor: 0.2 # Ruins armor 
      ToHealth: 0.5 # Worse at health damage. 
      ToStun: 0.65
      ToEnergy: 0.35 # Weakening
      ToMorale: 0.35 # Weakening
      toTime: 0.35 # Weakening
    clipSize: 1 # You only get one shot.

