manufacture:


# TODO: ADD MANUFACTURING PROJECTS FOR THINGS THAT ARE MEANT TO INCREASE A COUNTER FOR VARIOUS MISSIONS, OR UNLOCK OTHER TECH
# THE IDEA IS THAT ONCE YOU HAVE THE WARTIME GATEWAY TECH, YOU CAN DO MANY DIFFERENT THINGS TO INCREASE THE COUNTER
# ONCE THE COUNTER IS HIGH ENOUGH, THE EVENT TRIGGERS THAT DENOTES THAT YOU NOW HAVE "WON" AND CONTROL THE AREA


  - &STR_CRAFT_LOOTED
    name: STR_REPAINT_LOOTED_VALKYRIE
    category: STR_CRAFT
    requires:
      - STR_DEPOT_SUCCESSFULLY_RAIDED
    requiredItems:
      STR_SLAANESH_VEHICLE_TOKEN: 1
    space: 20
    time: 200
    cost: 20000
    producedItems:
      STR_VALKYRIE_SLAANESH: 1

  - name: STR_REPAINT_LOOTED_CHIMERAS
    refNode: *STR_CRAFT_LOOTED
    producedItems:
      STR_CHIMERA_LIGHT_SLAANESH: 1

  - name: STR_REPAINT_LOOTED_LIGHTNING
    refNode: *STR_CRAFT_LOOTED
    producedItems:
      STR_LIGHTNING_INTERCEPTOR_SLAANESH: 1

  - name: STR_SPREAD_TRUE_FAITH_UNDERHIVE
    time: 5000
    cost: 400000
    requires:
      - STR_WAR_FOR_THE_UNDERHIVE
      - STR_UNDERHIVE_NOT_CONVERTED
    producedItems:
      STR_UNDERHIVE_CULT_TOKEN: 1
      STR_SLAANESHPATH_PIETY: 200


