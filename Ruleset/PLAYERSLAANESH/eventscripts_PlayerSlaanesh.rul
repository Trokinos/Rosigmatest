

eventScripts:

#TODO: SET UP ALTERNATIVE WAY FOR GSC ARBITES TO SPAWN

 ######## INTRO EVENTS #########
# INTRO EVENTSCRIPTS
  - type: STR_SLAANESHPATH_INTRO_A_EVENTSCRIPT
    oneTimeSequentialEvents:
      - STR_SLAANESHPATH_INTRO_A_EVENT
    firstMonth: 0
    lastMonth: 0
    executionOdds: 100
    researchTriggers:
      STR_ARBITES: true

  - type: STR_SLAANESHPATH_INTRO_D_EVENTSCRIPT
    oneTimeSequentialEvents:
      - STR_SLAANESHPATH_INTRO_D_EVENT
    firstMonth: 0
    lastMonth: 0
    executionOdds: 100
    researchTriggers:
      STR_ARBITES: true


  - type: STR_SLAANESHPATH_INTRO_CULTISTS_EVENTSCRIPT
    oneTimeSequentialEvents:
      - STR_SLAANESHPATH_CULTISTS_ARRIVE_EVENT
    firstMonth: 0
    lastMonth: 0
    executionOdds: 100
    researchTriggers:
      STR_ARBITES: true

# Timed techs or gate events
  - type: STR_SLAANESHPATH_VEHICLES_AVAILABLE_EVENTSCRIPT
    oneTimeSequentialEvents:
      - STR_SLAANESHPATH_VEHICLES_AVAILABLE_EVENT
    firstMonth: 1
    lastMonth: 1
    executionOdds: 100
    researchTriggers:
      STR_ARBITES: true

# UNDERHIVE EVENTS

  - type: STR_SLAANESHPATH_GSC_DISCOVERED_EVENTSCRIPT
    oneTimeSequentialEvents:
      - STR_SUFFER_NOT_THE_XENO_EVENT
    firstMonth: 1
    lastMonth: 3
    executionOdds: 100
    researchTriggers:
      STR_SLAANESHPATH_GATE: true