eventScripts:

 ######## INTRO EVENTS #########
 #### TIMED INTRO EVENTS SHOULD TRIGGER AT 24 HOURS AND 48 HOURS

  - type: STR_SLAANESHPATH_INTRO_A_EVENTSCRIPT
