adhocScripts:

 # 10040 minutes in a week
 # NOTE: Currently all items and units will have arrived at HQ on the 6th day of January.
 # Missions should not start generating before the 10th.
 #
 #
 #
 #
 #
 #
 #
 #
 #
 #
 #
 #
 #

### start adhocScript Mission
 # Copied from TAU, readjust later. Triggers missions in player region.

  - &STR_SLAANESHPATH_START_MISSION
    type: adhocGameStartSlaanesh
    # initial mission in player region
    adhocMissionScriptTags: ["gameStartSlaanesh"]
    missionWeights:
      0:
        STR_ALIEN_RESEARCH: 10
        STR_ALIEN_HARVEST: 10
        STR_ALIEN_ABDUCTION: 30
        STR_NURGLE_HARVEST: 8
        STR_ALIEN_RESEARCH_TZEENTCH: 15
        STR_ALIEN_HARVEST_TZEENTCH: 8
    targetBaseOdds: 100
    startDelay: 7200  # 5 days
    randomDelay: 4320  # additional random 0 to 3 days
    useTable: true
    maxRuns: 1
    varName: GameStartSlaanesh

  - type: adhocStarterBaseSlaanesh
    missionWeights:
      0:
        STR_TS_CULTIST_BASE_GV: 100
    regionWeights:
      0:
        STR_NORTH_AMERICA: 18
        STR_ARCTIC: 4
        STR_ANTARCTICA: 4
        STR_SOUTH_AMERICA: 10
        STR_EUROPE: 16
        STR_NORTH_AFRICA: 12
        STR_SOUTHERN_AFRICA: 8
        STR_CENTRAL_ASIA: 12
        STR_SOUTH_EAST_ASIA: 15
        STR_SIBERIA: 10
        STR_AUSTRALASIA: 10
    useTable: false
    startDelay: 20080  # 2-3 weeks
    randomDelay: 10040
    adhocMissionScriptTags: ["adhocStarterBaseSlaanesh"]


events:

  - name: STR_SLAANESHPATH_CHOSEN_EVENT
    adhocMissionScriptTags: ["gameStartSlaanesh", "adhocStarterBaseSlaanesh"]
    description: STR_SLAANESHPATH_CHOSEN_EVENT_CODEX_DESCRIPTION
    background: AdeptasAttackedBG.scr
    timer: 300
  
  ###### INTRO EVENTS ######
  - name: STR_SLAANESHPATH_INTRO_A_EVENT
    description: STR_SLAANESHPATH_INTRO_A_EVENT_CODEX_DESCRIPTION
    background: SistersReinforcements3BG.SCR
    interruptResearch: STR_NOT_SLAANESHPATH
    timer: 1560  # 26 hours

  - name: STR_SLAANESHPATH_INTRO_B_EVENT ### BUNKER EVENT, TRIGGERS SERVITOR TRANSFER
    description: STR_SLAANESHPATH_INTRO_B_EVENT_CODEX_DESCRIPTION
    background: CHAOSCULTSISTERCHAOSBG.SCR
    spawnedPersons: 5
    spawnedPersonType: STR_ENGINEER


  - name: STR_SLAANESHPATH_INTRO_C_EVENT
    description: STR_SLAANESHPATH_INTRO_C_EVENT_CODEX_DESCRIPTION
    background: CHAOSCULTSISTERCORRUPTBG.SCR

  - name: STR_SLAANESHPATH_INTRO_D_EVENT #### Power failure event
    description: STR_SLAANESHPATH_INTRO_D_EVENT_CODEX_DESCRIPTION
    background: ARMORYRAID.SCR
    interruptResearch: STR_NOT_SLAANESHPATH
    timer: 2880  # 48 hours

  - name: STR_SLAANESHPATH_GATE_EVENT # This is the event that gives you the sisters.
    description: STR_SLAANESHPATH_CHOSEN_EVENT_CODEX_DESCRIPTION
    background: CHAOSCULTTEMPLEADEPTASBG.SCR
    spawnedPersons: 10
    spawnedPersonType: STR_SLAANESHPATH_HANDMAIDEN
    everyMultiSoldierList:
      STR_SLAANESHPATH_HANDMAIDEN: 10
    everyMultiItemList:
      STR_ADEPTAS_MEDICAE_ARMORSTORE: 2
      STR_BOLTER_DEAZ: 2
      STR_LIGHT_BOLTER_AMMO: 6
      STR_BOLTER_CANTUS: 6
      STR_CANTUS_BOLTER_AMMO: 30
      STR_CANTUS_BOLTER_AMMO_PENETRATOR: 20 # PLACEHOLDER FOR TESTING
      STR_BOLTPISTOL_DEAZ: 6
      STR_LIGHT_BOLTPISTOL_AMMO: 18
      STR_BOLTER_CANTUS_SLAAN: 6 # PLACEHOLDER FOR TESTING
      STR_CHOKE_GRENADE40: 20 # PLACEHOLDER FOR TESTING
      STR_SONIC_GRENADE40: 20 #PPLACEHOLDER FOR TESTING
      STR_BOLTER_CANTUS_GL: 6 # PLACEHOLDER FOR TESTING
      STR_MELTA_GRENADE40: 10 # PLACEHOLDER FOR TESTING

# TO DO: CHANGE THIS EVENT! THIS NEEDS TO BE TRIGGERED BY STR_SLAANESHPATH_GATE DIRECTLY!
# ADD CODEX DESCRIPTION FOR PLOT


  - name: STR_SLAANESHPATH_CULTISTS_ARRIVE_EVENT 
    description: STR_SLAANESHPATH_CHOSEN_EVENT_CODEX_DESCRIPTION
    background: CHAOSCULTDRAFTBG.SCR
    timer: 5700  # 95 hours
    interruptResearch: STR_NOT_SLAANESHPATH
    spawnedPersons: 8
    spawnedCraftType: STR_TRUCKBASE_CHAOS
    spawnedPersonType: STR_SLAANESHPATH_VICTUAL_BROTHER
    everyMultiSoldierList:
      STR_SLAANESHPATH_VICTUAL_BROTHER: 8