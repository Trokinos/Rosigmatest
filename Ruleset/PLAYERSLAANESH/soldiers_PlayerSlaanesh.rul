extended:
  tagsFile: Ruleset/tags_ROSIGMA.rul


# STRUCTURE of this file
# SISTERS.TIER1 # Immaculate Sisterhood units
# CULTISTS TIER1 # BASIC cultists. 


soldiers:

# SISTERS.TIER1 #

  - type: STR_SLAANESH_HANDMAIDEN  # Tier 1 corrupted Sororitas. Significantly more elite than loyalist novices.  
    flagOffset: 21 # !!! need to fix this later !!!
    costBuy: 20000  # Not meant to be purchased directly. 
    costSalary: 15000 # Thrice as expensive as a Novice; Hedonist lifestyles
    requires: ### >Remove this later.< ###
    - STR_SLAANESH_SELECTED
    minStats:
      tu: 55 # Slaanesh Influence
      stamina: 60 # 5 Slaanesh influence
      health: 35 # 5 More vs Adeptas
      bravery: 60 # Followers of Slaanesh do not fear death
      reactions: 40 # Slaanesh influence
      firing: 45 # 10 More
      throwing: 35 # 5 More
      strength: 16
      psiStrength: 25
      psiSkill: 30
      melee: 40 # Slaanesh Influence
    maxStats:
      tu: 75 # Slaanesh influence
      stamina: 80 # Slaanesh Influence
      health: 45
      bravery: 100 # Followers of Slaanesh do not fear death
      reactions: 80 # Slaanesh Influence
      firing: 60 # 5 More
      throwing: 50 # 5 More
      strength: 30
      psiStrength: 90 # Uncapped Psi strength, can be gifted psyker powers by Slaanesh
      psiSkill: 60
      melee: 60 # Slaanesh Influence
    statCaps:
      tu: 105 # Slaanesh Influence
      stamina: 115 # Slaanesh Influence
      health: 75 # 5 More
      bravery: 110
      reactions: 120 # Slaanesh Influence
      firing: 105 # 5 More
      throwing: 75 # 5 More
      strength: 75 # 5 Less
      psiStrength: 100
      psiSkill: 100
      melee: 120
    trainingStatCaps:
      tu: 85 # 5 More
      stamina: 80
      health: 65
      firing: 80 # 5 More
      throwing: 70
      strength: 50
      psiStrength: 60
      psiSkill: 100
      melee: 80 # Slaanesh Influence
    dogfightExperience: # Same as Adeptas pilots; Slaanesh devotees are eager to experience new sensations
      bravery: 20
      reactions: 35
      firing: 30
    armor: STR_SLAANESH_HANDMAIDEN_ARMOR # Slightly improved Cantus Armor
    allowPiloting: true
    allowPromotion: true
    standHeight: 22
    kneelHeight: 14
    femaleFrequency: 95
    avatarOffsetX: 66
    avatarOffsetY: 42
    soldierNames:
      - delete
      - Names/adeptas_novice.nam
    deathMale: [{mod: 40k, index: 749}, {mod: 40k, index: 750}, {mod: 40k, index: 751}, {mod: 40k, index: 752}]
    deathFemale: [{mod: 40k, index: 744}, {mod: 40k, index: 745}, {mod: 40k, index: 746}, {mod: 40k, index: 747}, {mod: 40k, index: 748}]
    rankStrings:
      - STR_SLAANESH_HANDMAIDEN_RANK_0
      - STR_SLAANESH_HANDMAIDEN_RANK_1
      - STR_SLAANESH_HANDMAIDEN_RANK_2
      - STR_SLAANESH_HANDMAIDEN_RANK_3
    rankSprite: 4144
    rankBattleSprite: 4144 
    rankTinySprite: 4144

  - type: STR_SLAANESH_EXALTEDMAIDEN  # Exalted Handmaidens. Essentially the slaanesh cantus promotion.  
    flagOffset: 21 # !!! need to fix this later !!!
    costBuy: 20000  # Temporary. 
    costSalary: 18000 # Somewhat higher salary than base.
    requires: ### >Remove this later.< ###
    - STR_SLAANESH_SELECTED
    minStats: # Don't matter
      tu: 55 
      stamina: 60
      health: 35 
      bravery: 60 
      reactions: 40 
      firing: 45 
      throwing: 35 
      strength: 16
      psiStrength: 25
      psiSkill: 30
      melee: 40 
    maxStats: # Don't matter
      tu: 75 
      stamina: 80 
      health: 45
      bravery: 100 
      reactions: 80 
      firing: 60 # 
      throwing: 50 
      strength: 30
      psiStrength: 90
      psiSkill: 60
      melee: 60 
    statCaps:
      tu: 115 # + 10
      stamina: 125 # + 10
      health: 75 # unchanged
      bravery: 110
      reactions: 130 # + 10
      firing: 110 # + 10
      throwing: 75 # unchanged
      strength: 75 # unchanged
      psiStrength: 100
      psiSkill: 120 # + 20
      melee: 130 # + 10
    trainingStatCaps:
      tu: 90 # +5  
      stamina: 85 # +5 
      health: 70 # +5 
      firing: 85 #  +5 
      throwing: 70
      strength: 55 # +5 
      psiStrength: 60
      psiSkill: 100
      melee: 85 # +5
    dogfightExperience: # Same as Adeptas pilots; Slaanesh devotees are eager to experience new sensations
      bravery: 20
      reactions: 35
      firing: 30
    armor: STR_SLAANESH_EXALTEDMAIDEN_ARMOR
    allowPiloting: true
    allowPromotion: false
    standHeight: 22
    kneelHeight: 14
    femaleFrequency: 95
    avatarOffsetX: 66
    avatarOffsetY: 42
    soldierNames:
      - delete
      - Names/adeptas_novice.nam
    deathMale: [{mod: 40k, index: 749}, {mod: 40k, index: 750}, {mod: 40k, index: 751}, {mod: 40k, index: 752}]
    deathFemale: [{mod: 40k, index: 744}, {mod: 40k, index: 745}, {mod: 40k, index: 746}, {mod: 40k, index: 747}, {mod: 40k, index: 748}]
    rankStrings:
    - STR_SLAANESH_EXALTEDMAIDEN_RANK_0
    rankSprite: 4148
    rankBattleSprite: 4148 
    rankTinySprite: 4148


 #### SLAANESH BASIC CULTIST. More expensive than PLAYERCHAOS cultists, but have better scaling potential.

  - type: STR_SLAANESH_VICTUAL_CULTIST 
    costBuy: 12000
    costSalary: 8000
    requires:
      - STR_RITUALS_OF_WORSHIP # PLACEHOLDER
    minStats:
      tu: 65
      stamina: 45 # +5
      health: 25
      bravery: 30 # +10
      reactions: 35
      firing: 38 # +3 
      throwing: 35
      strength: 12 # +2 vs Flesh cultist
      psiStrength: 10
      psiSkill: 8
      melee: 35 # +10
    maxStats:
      tu: 80
      stamina: 70
      health: 35 # +5 vs flesh cultist
      bravery: 60 # +10 
      reactions: 60 # +5
      firing: 60 # + 5
      throwing: 60
      strength: 22 # +4
      psiStrength: 40
      psiSkill: 8
      melee: 60
    statCaps:
      tu: 115
      stamina: 120
      health: 90
      bravery: 110
      reactions: 115
      firing: 125
      throwing: 120
      strength: 90
      psiStrength: 100
      psiSkill: 100
      melee: 135
    trainingStatCaps:
      tu: 70
      stamina: 70 # + 10
      health: 40 # + 15
      bravery: 40
      reactions: 55
      firing: 65 # +5
      throwing: 55
      strength: 40 # + 20
      psiStrength: 30
      psiSkill: 100
      melee: 60
    armor: STR_SLAANESH_CULTIST_ARMOR_PLAYER
    standHeight: 21
    kneelHeight: 16
    deathMale: [{mod: 40k, index: 41}, {mod: 40k, index: 42}, {mod: 40k, index: 43}]
    deathFemale: [{mod: 40k, index: 44}, {mod: 40k, index: 45}, {mod: 40k, index: 46}]
    allowPiloting: false
    allowPromotion: true
    rankStrings:
    - STR_SLAANESH_SERVANT-RANK_0
    - STR_SLAANESH_SERVANT-RANK_1
    - STR_SLAANESH_SERVANT-RANK_2
    - STR_SLAANESH_SERVANT-RANK_3
    rankSprite: {mod: 40k, index: 80} # ADD LATER
    rankBattleSprite: {mod: 40k, index: 194} # ADD LATER
    rankTinySprite: {mod: 40k, index: 127} # ADD LATER
    femaleFrequency: 20
    avatarOffsetX: 66
    avatarOffsetY: 42
    soldierNames:
      - delete
      - Names/cultists.nam
    value: 4
    moraleLossWhenKilled: 75  # people don't care about the grunts so much
