extended:
  tagsFile: Ruleset/tags_ROSIGMA.rul


# STRUCTURE of this file
# SISTERS.TIER1 # Immaculate Sisterhood units
# CULTISTS TIER1 # BASIC cultists.


soldiers:

# SISTERS.TIER1 #

  - type: STR_SLAANESHPATH_HANDMAIDEN  # Tier 1 corrupted Sororitas. Significantly more elite than loyalist novices.
    flagOffset: 21 # !!! need to fix this later !!!
    costBuy: 20000  # Not meant to be purchased directly.
    costSalary: 15000 # Thrice as expensive as a Novice; Hedonist lifestyles
    requires: ### >Remove this later.< ###
      - STR_SLAANESHPATH_GATE
    minStats:
      tu: 55 # Slaanesh Influence
      stamina: 60 # 5 Slaanesh influence
      health: 35 # 5 More vs Adeptas
      bravery: 60 # Followers of Slaanesh do not fear death
      reactions: 40 # Slaanesh influence
      firing: 45 # 10 More
      throwing: 35 # 5 More
      strength: 16
      psiStrength: 25
      psiSkill: 30
      melee: 40 # Slaanesh Influence
    maxStats:
      tu: 75 # Slaanesh influence
      stamina: 80 # Slaanesh Influence
      health: 45
      bravery: 100 # Followers of Slaanesh do not fear death
      reactions: 80 # Slaanesh Influence
      firing: 60 # 5 More
      throwing: 50 # 5 More
      strength: 30
      psiStrength: 90 # Uncapped Psi strength, can be gifted psyker powers by Slaanesh
      psiSkill: 60
      melee: 60 # Slaanesh Influence
    statCaps:
      tu: 105 # Slaanesh Influence
      stamina: 115 # Slaanesh Influence
      health: 75 # 5 More
      bravery: 110
      reactions: 120 # Slaanesh Influence
      firing: 105 # 5 More
      throwing: 75 # 5 More
      strength: 75 # 5 Less
      psiStrength: 100
      psiSkill: 100
      melee: 120
    trainingStatCaps:
      tu: 85 # 5 More
      stamina: 80
      health: 65
      firing: 80 # 5 More
      throwing: 70
      strength: 50
      psiStrength: 60
      psiSkill: 100
      melee: 80 # Slaanesh Influence
    dogfightExperience: # Same as Adeptas pilots; Slaanesh devotees are eager to experience new sensations
      bravery: 20
      reactions: 35
      firing: 30
    armor: STR_SLAANESHPATH_HANDMAIDEN_ARMOR # Slightly improved Cantus Armor
    allowPiloting: true
    allowPromotion: true
    standHeight: 22
    kneelHeight: 14
    femaleFrequency: 95
    avatarOffsetX: 66
    avatarOffsetY: 42
    soldierNames:
      - delete
      - Names/adeptas_novice.nam
    deathMale: [{mod: 40k, index: 749}, {mod: 40k, index: 750}, {mod: 40k, index: 751}, {mod: 40k, index: 752}]
    deathFemale: [{mod: 40k, index: 744}, {mod: 40k, index: 745}, {mod: 40k, index: 746}, {mod: 40k, index: 747}, {mod: 40k, index: 748}]
    rankStrings:
      - STR_SLAANESHPATH_HANDMAIDEN_RANK_0
      - STR_SLAANESHPATH_HANDMAIDEN_RANK_1
      - STR_SLAANESHPATH_HANDMAIDEN_RANK_2
      - STR_SLAANESHPATH_HANDMAIDEN_RANK_3
    rankSprite: 4144
    rankBattleSprite: 4144
    rankTinySprite: 4144

  - type: STR_SLAANESHPATH_EXALTEDMAIDEN  # Exalted Handmaidens. Essentially the slaanesh cantus promotion.
    flagOffset: 21 # !!! need to fix this later !!!
    costBuy: 20000  # Temporary.
    costSalary: 18000 # Somewhat higher salary than base.
    requires: ### >Remove this later.< ###
      - STR_SLAANESHPATH_GATE
    minStats: # Don't matter
      tu: 55
      stamina: 60
      health: 35
      bravery: 60
      reactions: 40
      firing: 45
      throwing: 35
      strength: 16
      psiStrength: 25
      psiSkill: 30
      melee: 40
    maxStats: # Don't matter
      tu: 75
      stamina: 80
      health: 45
      bravery: 100
      reactions: 80
      firing: 60 #
      throwing: 50
      strength: 30
      psiStrength: 90
      psiSkill: 60
      melee: 60
    statCaps:
      tu: 115 # + 10
      stamina: 125 # + 10
      health: 75 # unchanged
      bravery: 110
      reactions: 130 # + 10
      firing: 110 # + 10
      throwing: 75 # unchanged
      strength: 75 # unchanged
      psiStrength: 100
      psiSkill: 120 # + 20
      melee: 130 # + 10
    trainingStatCaps:
      tu: 90 # +5
      stamina: 85 # +5
      health: 70 # +5
      firing: 85 #  +5
      throwing: 70
      strength: 55 # +5
      psiStrength: 60
      psiSkill: 100
      melee: 85 # +5
    dogfightExperience: # Same as Adeptas pilots; Slaanesh devotees are eager to experience new sensations
      bravery: 20
      reactions: 35
      firing: 30
    armor: STR_SLAANESHPATH_EXALTEDMAIDEN_ARMOR
    allowPiloting: true
    allowPromotion: false
    standHeight: 22
    kneelHeight: 14
    femaleFrequency: 95
    avatarOffsetX: 66
    avatarOffsetY: 42
    soldierNames:
      - delete
      - Names/adeptas_novice.nam
    deathMale: [{mod: 40k, index: 749}, {mod: 40k, index: 750}, {mod: 40k, index: 751}, {mod: 40k, index: 752}]
    deathFemale: [{mod: 40k, index: 744}, {mod: 40k, index: 745}, {mod: 40k, index: 746}, {mod: 40k, index: 747}, {mod: 40k, index: 748}]
    rankStrings:
      - STR_SLAANESHPATH_EXALTEDMAIDEN_RANK_0
    rankSprite: 4148
    rankBattleSprite: 4148
    rankTinySprite: 4148

