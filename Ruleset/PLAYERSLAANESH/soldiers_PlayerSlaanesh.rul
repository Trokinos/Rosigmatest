      throwing: 70
      strength: 50
      psiStrength: 60
      psiSkill: 100
      melee: 80
    dogfightExperience: # Same as Adeptas pilots; Slaanesh devotees are eager to experience new sensations
      bravery: 20
      reactions: 35
      firing: 30
    armor: STR_SLAANESHPATH_HANDMAIDEN_ARMOR # Adepta Sororitas Flak Armor
