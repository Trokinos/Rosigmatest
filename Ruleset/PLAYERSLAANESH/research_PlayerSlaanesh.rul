 ##### MELTA, PLASMA & LASCANNON RESEARCH #####
 ###################################

  - name: STR_CONTACT_HERETEKS # Codex entry. Unlocks the ability to produce a tribute.
    cost: 50
    dependencies:
      - STR_CONTACT_ARMS_SMUGGLERS
      - STR_BLACK_MARKET_AMMUNITION
    unlocks:
      - STR_HERETEK_TRIBUTE_PRODUCTION
    getOneFree:
      - STR_ELERIUM_115

  - name: STR_HERETEK_TRIBUTE
    cost: 30
    dependencies:
      - STR_CONTACT_HERETEKS
    needItem: true
    destroyItem: true
    disables:
      - STR_HERETEK_TRIBUTE_PRODUCTION
    getOneFree:
      - STR_ALIEN_ALLOYS

  - name: STR_HERETEK_TRIBUTE_PRODUCTION
    cost: 0
    dependencies:
      - STR_GENERALLOCK
  #This is the tech that allows you to produce the tribute.
  # Gets disabled once the tribute itself has been researched.

  - name: STR_HERETEK_MANUFACTURING_SUPPORT
    cost: 0
    dependencies:
