  ### The Slaanesh condition is
  ### STR_ARBITES: true
  ### STR_NOT_CHAOSCULT: true

  - name: STR_NOT_SLAANESHPATH        # (Not a supple servant of Slaanesh)



  - name: STR_SLAANESHPATH
    points: 0
    cost: 5
    lookup: STR_SLAANESHPATH_SELECTED
    dependencies:
      - STR_ARBITES
     #lookup: STR_SLAANESHPATH_SELECTED
    unlocks:
      - STR_ALIENS_ONLY # Chaos corruption
      - STR_NOT_IMPERIUM
      - STR_NOT_CHAOSCULT
      - STR_NOT_THE_IMPERIAL_LAW
      #- STR_ENDGANGERSBASE    # Stop the onslaught of gang events
      - STR_GENESTEALERS_INACTIVE # no genestealers
      #- STR_GSC_ARBITES_SPAWNED   # prevent GSC arbites spawn
      - STR_SLAANESHPATH_SELECTED
    disables:
      - STR_NOT_SLAANESHPATH
      - STR_GENESTEALERS_ACTIVE #Genestealers
      - STR_CHAOS_STRATEGY_ARBITES
      - STR_CHAOS_STRATEGY
      - STR_ELDAR_STRATEGY
      - STR_GREENEST_ORKZ
      - STR_TAU_GUEVESA_STRATEGY_GV
      - STR_CHAPTER_PURITY
      # STR_PSI_LAB
      # STR_PSI_AMP
      - STR_THE_MARTIAN_SOLUTION
      - STR_DIFFICULTY_OPTIONS    # does not have harder missions yet
      - STR_DEFAULT_CAMPAIGN

    ############## DISABLED GENERIC TECHS GO HERE ###############
      - STR_SMOKE # Alternative tech exists.
      - STR_MOTION_SCANNER
      - STR_COMBAT_SERVITOR_PROGRAM # In the eyes of Slaanesh, lobotomizing soldiers ruins all the fun.
      - STR_PHOSPHOR_GRENADE # Replaced by balefire grenades.
      - STR_MELTAGUN_TECH # This faction gets its own alternative melta weaponry.
      - STR_LIGHT_MELTAGUN_TECH
      - STR_LASCAN_TECH
    ############## DISABLED CHAOS-RELATED TECHS GO HERE #########
      - STR_ALIEN_SURGERY # Followers of Slaanesh do not need to research chaos implements normally
      - STR_ALIEN_FOOD # Followers of Slaanesh do not need to research chaos implements normally
      - STR_ALIEN_ORIGINS # Followers of Slaanesh do not need to research chaos implements normally
      - STR_CHAOS_PATH # Already on the only TRUE chaos path!
      - STR_CHAOS_SORCERY
    ###################################################

    spawnedEvent: STR_SLAANESHPATH_CHOSEN_EVENT # Lost and Alone. Triggers adhocscript.

  - name: STR_SLAANESHPATH_SELECTED
    dependencies:
      - STR_GENERALLOCK
    cost: 0


