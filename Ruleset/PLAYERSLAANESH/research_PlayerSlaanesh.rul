    cost: 75
    dependencies:
      - STR_CONTACT_HERETEKS
      - STR_IMMACULATE_LASGUN_TECHNOLOGY

  - name: STR_IMMACULATE_PLASMA_TECHNOLOGY
    cost: 50
    dependencies:
      - STR_CONTACT_HERETEKS
