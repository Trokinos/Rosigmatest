###

research:

  ### The Slaanesh condition is
  ### STR_ARBITES: true
  ### STR_NOT_CHAOSCULT: true

  - name: STR_SLAANESHPATH_SELECTED        # (Slaanesh strategy skillfully selected)
    dependencies:
      - STR_GENERALLOCK
  - name: STR_NOT_SLAANESHPATH        # (Not a supple servant of Slaanesh)



  - name: STR_SLAANESHPATH
    points: 0
    cost: 5
    dependencies:
      - STR_ARBITES
     #lookup: STR_SLAANESHPATH_SELECTED
    unlocks:
      - STR_ALIENS_ONLY # Chaos corruption
      - STR_NOT_IMPERIUM
      - STR_NOT_CHAOSCULT
      - STR_NOT_THE_IMPERIAL_LAW
      #- STR_ENDGANGERSBASE    # Stop the onslaught of gang events
      - STR_GENESTEALERS_INACTIVE # no genestealers
      #- STR_GSC_ARBITES_SPAWNED   # prevent GSC arbites spawn
      - STR_SLAANESHPATH_SELECTED
    disables:
      - STR_NOT_SLAANESHPATH
      - STR_GENESTEALERS_ACTIVE
      - STR_CHAOS_STRATEGY_ARBITES
      - STR_CHAOS_STRATEGY
      - STR_ELDAR_STRATEGY
      - STR_GREENEST_ORKZ
      - STR_TAU_GUEVESA_STRATEGY_GV
      - STR_CHAPTER_PURITY
      # STR_PSI_LAB
      # STR_PSI_AMP
      - STR_THE_MARTIAN_SOLUTION
      - STR_DIFFICULTY_OPTIONS    # does not have harder missions yet
      - STR_DEFAULT_CAMPAIGN

     ############## DISABLED GENERIC TECHS GO HERE ###############
      - STR_SMOKE # Alternative tech exists.
      - STR_MOTION_SCANNER
      - STR_COMBAT_SERVITOR_PROGRAM # In the eyes of Slaanesh, lobotomizing soldiers ruins all the fun.
      - STR_ALIEN_ALLOYS # Re-enabled later.
      - STR_ELERIUM_115 # Re-enabled later.
      - STR_PHOSPHOR_GRENADE # Not available to the strategy.
      - STR_MELTAGUN_TECH # This faction gets its own alternative melta weaponry.
     ############## DISABLED CHAOS-RELATED TECHS GO HERE #########
      - STR_ALIEN_SURGERY # Followers of Slaanesh do not need to research chaos implements normally
      - STR_ALIEN_FOOD # Followers of Slaanesh do not need to research chaos implements normally
      - STR_ALIEN_ORIGINS # Followers of Slaanesh do not need to research chaos implements normally
      - STR_CHAOS_PATH # Already on the only TRUE chaos path!
      - STR_CHAOS_SORCERY
     ###################################################

    spawnedEvent: STR_SLAANESHPATH_CHOSEN_EVENT # Lost and Alone. Triggers adhocscript.

 ##################### SECTION FOR INTRO-RELATED TECHS ######################
 ### ALL THESE TECHS ARE REQUIRED TO ACCESS THE REAL TECH TREE ###
  - name: STR_SLAANESHPATH_INTRO_BUNKER
    cost: 5
    points: 0
    dependencies:
      - STR_SLAANESHPATH
    unlocks: 
      - STR_SLAANESHPATH_INTRO_CALLING
    spawnedEvent: STR_SLAANESHPATH_INTRO_B_EVENT

  - name: STR_SLAANESHPATH_INTRO_CALLING
    cost: 5
    points: 0
    dependencies:
      - STR_GENERALLOCK
    unlocks: 
      - STR_SLAANESHPATH_GATE
    spawnedEvent: STR_SLAANESHPATH_INTRO_C_EVENT

  - name: STR_SLAANESHPATH_GATE
    cost: 5
    points: 0
    dependencies:
      - STR_GENERALLOCK
    unlocks:
      - STR_SCIENTISTS_AND_ENGINEERS_AVAILABLE
      - STR_RITUALS_OF_WORSHIP
    # - STR_CHAOS_ARMORY_EXAM_SLAANESH (This should be moved to later in the tree)
    spawnedEvent: STR_SLAANESHPATH_GATE_EVENT

  #- name: STR_CHOSEN_SLAANESH_STRATEGY #research lookup for Slaanesh chosen
  # cost: 0
  #  points: 0
  #  dependencies:
  #    - STR_GENERALLOCK

  ################# SECTION FOR EARLY GAME INSTANT UNLOCKS ######################
  - name: STR_RITUALS_OF_WORSHIP # Tech for basic piety projects.
    cost: 0
    points: 0
    dependencies:
      - STR_GENERALLOCK

  ################### END OF SECTION ##################

  ################### SECTION FOR EARLY GAME PROGRESSION TECHS #############

  - name: STR_CHAMBERS_OF_AGONY
    cost: 10
    dependencies:
      - STR_IMPLEMENTS_OF_TORTURE

  - name: STR_CONTACT_ARMS_SMUGGLERS # Codex entry.
    cost: 20
    dependencies:
      - STR_SLAANESHPATH_GATE

  - name: STR_BLACK_MARKET_AMMUNITION # Codex Entry. 
    cost: 20
    dependencies:
      - STR_CONTACT_ARMS_SMUGGLERS
    unlocks:
      - STR_BLACK_MARKET_AMMO_TRADE

  - name: STR_BLACK_MARKET_AMMO_TRADE # Tech that enables buying black market ammo. Disabled later.
    cost: 0
    dependencies:
      - STR_GENERALLOCK
  
  - name: STR_CONTACT_HERETEKS # Codex entry. This project unlocks a project requiring warp stones.
    cost: 20
    dependencies:
      - STR_CONTACT_ARMS_SMUGGLERS
      - STR_PROCURE_TRANSPORTATION
      - STR_BLACK_MARKET_AMMUNITION

 ###################################
 ##### PIETY & RITUAL RESEARCH #####
 ###################################

  - name: STR_SOULS_FOR_SLAANESH # Unlocks sacrifices. Codex Entry.
    cost: 20
    points: 20
    dependencies:
      - STR_GIFTS_OF_SLAANESH

  - name: STR_GIFTS_OF_SLAANESH # Gateway tech that also gives access to a few basic slaanesh-themed weapons.
    cost: 20
    dependencies:
    - STR_SLAANESHPATH_GATE



 ### TIER 1 PIETY PROJECTS
 
  # Gives a manufacturing project for corrupted cantus bolters.
  # Disables once Hereteks are capable of manufacturing. 

 ###################################
 ### WEAPON TECH LEVEL RESEARCH ####
 ###################################
 
### -<TIER 1 WEAPON TECH LEVEL PROJECTS>- ###

  - name: STR_MELTA_CARBINE_TECHNOLOGY
    cost: 150


 # Basic bolter weaponry conversion tech.
  - name: STR_CORRUPT_WEAPONRY 
    cost: 50
    points: 10
    dependencies:
      - STR_GIFTS_OF_SLAANESH
    unlocks:
    - STR_SLAANESH_WEAPON_CORRUPTION_TIER_1
  #Tech that gives access to weapon conversions through piety.
  #Gets disabled once the ability to manufacture these weapons is unlocked. 
  - name: STR_SLAANESH_WEAPON_CORRUPTION_TIER_1
    cost: 0
    points: 0
    dependencies:
    - STR_CORRUPT_WEAPONRY
  #Disabler for basic weapon corruption. Once you have this tech it's faster and cheaper to buy them.
  - name: STR_SLAANESH_WEAPON_MANUFACTURE_TIER_1
    cost: 0
    points: 0
    dependencies:
    - STR_GENERALLOCK
    disables:
    - STR_SLAANESH_WEAPON_CORRUPTION_TIER_1

 ##################################
 ##### TERROR WEAPON RESEARCH #####
