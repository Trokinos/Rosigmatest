missionScripts:


 #TODO: Adjust warp storm script to put higher weight on Khorne and Tzeentch, lower on Nurgle. 
 #TODO: Add more sister lists to warp storm.

 ### BASE GENERATION

  - type: newBasesEarlySlaaneshpath
    missionWeights:
      0:
        STR_TS_CULTIST_BASE_GV: 33
        STR_KTS_TRAITOR_GUARD_BASE_GV: 33
    firstMonth: 1
    lastMonth: 2
    startDelay: 120
    randomDelay: 20160 # Up to 2 weeks random delay
    executionOdds: 70
    researchTriggers:
      STR_DEFAULT_CAMPAIGN: false
      STR_SLAANESHPATH: true

  - &STR_NORMAL_CHAOSMISSION_TABLESLAANESH # Warp storm. For now this is the chaos cult
    type: warpStormSLAANESH
    firstMonth: 1
    missionWeights:
      0:  # equal distribution for now
        STR_ALIEN_RESEARCH: 15
        STR_ALIEN_RESEARCH_TZEENTCH: 15
        STR_NURGLE_RESEARCH: 10
        STR_ALIEN_HARVEST: 15
        STR_NURGLE_HARVEST: 15
        STR_ALIEN_HARVEST_TZEENTCH: 10
        STR_ALIEN_ABDUCTION: 15
        STR_NURGLE_ABDUCTION: 10
        STR_ALIEN_ABDUCTION_TZEENTCH: 10
        STR_ALIEN_INFILTRATION: 5
        STR_NURGLE_INFILTRATION: 5
        STR_ALIEN_INFILTRATION_TZEENTCH: 5
        STR_IMPERIALS_ABDUCTION: 10
        STR_IMPERIALS_HARVEST: 10
        STR_SISIMPERIALS_ABDUCTION: 10
        STR_SISIMPERIALS_HARVEST: 10
        STR_IMPERIALGUARD_BASEV0: 60
        STR_BLOODYROSE_BASEV0: 60
      3:  # equal distribution for now
        STR_ALIEN_RESEARCH: 10
        STR_ALIEN_RESEARCH_TZEENTCH: 10
        STR_NURGLE_RESEARCH: 5
        STR_ALIEN_HARVEST: 10
        STR_NURGLE_HARVEST: 10
        STR_ALIEN_HARVEST_TZEENTCH: 5
        STR_ALIEN_ABDUCTION: 10
        STR_NURGLE_ABDUCTION: 5
        STR_ALIEN_ABDUCTION_TZEENTCH: 5
        STR_ALIEN_INFILTRATION: 5
        STR_NURGLE_INFILTRATION: 5
        STR_ALIEN_INFILTRATION_TZEENTCH: 5
        STR_IMPERIALS_ABDUCTION: 10
        STR_IMPERIALS_HARVEST: 10
        STR_SISIMPERIALS_ABDUCTION: 10
        STR_SISIMPERIALS_HARVEST: 10
        STR_IMPERIALGUARD_BASE: 30
        STR_ULTRAMARINE_BASE: 50
        STR_BLACKTEMPLAR_BASE: 50
        STR_SPACEWOLVES_BASE: 50
        STR_CRIMSONFIST_BASE: 50
        STR_SALAMANDER_BASE: 50
        STR_BLOODYROSE_BASE: 30
      5:  # equal distribution for now
        STR_ALIEN_RESEARCH: 10
        STR_ALIEN_RESEARCH_TZEENTCH: 10
        STR_NURGLE_RESEARCH: 5
        STR_ALIEN_HARVEST: 10
        STR_NURGLE_HARVEST: 10
        STR_ALIEN_HARVEST_TZEENTCH: 5
        STR_ALIEN_ABDUCTION: 10
        STR_NURGLE_ABDUCTION: 5
        STR_ALIEN_ABDUCTION_TZEENTCH: 5
        STR_ALIEN_INFILTRATION: 5
        STR_NURGLE_INFILTRATION: 5
        STR_ALIEN_INFILTRATION_TZEENTCH: 5
        STR_IMPERIALS_ABDUCTION: 10
        STR_IMPERIALS_HARVEST: 10
        STR_SISIMPERIALS_ABDUCTION: 10
        STR_SISIMPERIALS_HARVEST: 10
        STR_IMPERIALGUARD_BASE: 30
        STR_ULTRAMARINE_BASE: 50
        STR_BLACKTEMPLAR_BASE: 50
        STR_SPACEWOLVES_BASE: 50
        STR_CRIMSONFIST_BASE: 50
        STR_SALAMANDER_BASE: 50
        STR_BLOODYROSE_BASE: 30
        STR_TAU_ORCAEXPEDITION: 5 #delayed onset
        STR_TAU_DEVILFISH_EXPEDITION: 5
      7:  # equal distribution for now
        STR_ALIEN_RESEARCH: 5
        STR_ALIEN_RESEARCH_TZEENTCH: 5
        STR_NURGLE_RESEARCH: 5
        STR_ALIEN_HARVEST: 5
        STR_NURGLE_HARVEST: 5
        STR_ALIEN_HARVEST_TZEENTCH: 5
        STR_ALIEN_ABDUCTION: 5
        STR_NURGLE_ABDUCTION: 5
        STR_ALIEN_ABDUCTION_TZEENTCH: 5
        STR_ALIEN_INFILTRATION: 5
        STR_NURGLE_INFILTRATION: 5
        STR_ALIEN_INFILTRATION_TZEENTCH: 5
        STR_IMPERIALS_ABDUCTION: 10
        STR_IMPERIALS_HARVEST: 10
        STR_SISIMPERIALS_ABDUCTION: 10
        STR_SISIMPERIALS_HARVEST: 10
        STR_IMPERIALGUARD_BASE: 10
        STR_ULTRAMARINE_BASE: 70
        STR_BLACKTEMPLAR_BASE: 70
        STR_SPACEWOLVES_BASE: 70
        STR_CRIMSONFIST_BASE: 70
        STR_SALAMANDER_BASE: 70
        STR_BLOODYROSE_BASE: 30
        STR_TAU_ORCAEXPEDITION: 5 #delayed onset
        STR_TAU_DEVILFISH_EXPEDITION: 5
    researchTriggers:
      STR_HARDER_MISSIONS: false
      STR_SLAANESHPATH: true
  - type: warpStormBuildingSLAANESH
    refNode: *STR_NORMAL_CHAOSMISSION_TABLESLAANESH
    firstMonth: 3
    lastMonth: 5
    executionOdds: 50
  - type: warpStormRagingSLAANESH
    refNode: *STR_NORMAL_CHAOSMISSION_TABLESLAANESH
    firstMonth: 6

  - &STR_HARD_CHAOSMISSION_TABLESLAANESH
    type: warpStormHardSLAANESH
    missionWeights:
      0:  # equal distribution for now
        STR_ALIEN_RESEARCH_HARD: 20
        STR_NURGLE_RESEARCH_HARD: 20
        STR_ALIEN_RESEARCH_TZEENTCH_HARD: 20
        STR_ALIEN_HARVEST_HARD: 20
        STR_NURGLE_HARVEST_HARD: 20
        STR_ALIEN_HARVEST_TZEENTCH_HARD: 20
        STR_ALIEN_ABDUCTION_HARD: 20
        STR_NURGLE_ABDUCTION_HARD: 15
        STR_ALIEN_ABDUCTION_TZEENTCH_HARD: 15
        STR_ALIEN_INFILTRATION_HARD: 10
        STR_NURGLE_INFILTRATION_HARD: 10
        STR_ALIEN_INFILTRATION_TZEENTCH_HARD: 10
        STR_IMPERIALS_ABDUCTION: 10
        STR_IMPERIALS_HARVEST: 10
        STR_SISIMPERIALS_ABDUCTION: 10
        STR_SISIMPERIALS_HARVEST: 10
        STR_IMPERIALGUARD_BASE: 40
        STR_ULTRAMARINE_BASEV2: 40
        STR_BLACKTEMPLAR_BASEV2: 40
        STR_SPACEWOLVES_BASEV2: 40
        STR_CRIMSONFIST_BASEV2: 40
        STR_SALAMANDER_BASEV2: 40
        STR_BLOODYROSE_BASEV2: 40
      3:  # equal distribution for now
        STR_ALIEN_RESEARCH_HARD: 10
        STR_NURGLE_RESEARCH_HARD: 10
        STR_ALIEN_RESEARCH_TZEENTCH_HARD: 10
        STR_ALIEN_HARVEST_HARD: 10
        STR_NURGLE_HARVEST_HARD: 10
        STR_ALIEN_HARVEST_TZEENTCH_HARD: 10
        STR_ALIEN_ABDUCTION_HARD: 10
        STR_NURGLE_ABDUCTION_HARD: 10
        STR_ALIEN_ABDUCTION_TZEENTCH_HARD: 10
        STR_ALIEN_INFILTRATION_HARD: 5
        STR_NURGLE_INFILTRATION_HARD: 5
        STR_ALIEN_INFILTRATION_TZEENTCH_HARD: 5
        STR_IMPERIALS_ABDUCTION: 10
        STR_IMPERIALS_HARVEST: 10
        STR_SISIMPERIALS_ABDUCTION: 10
        STR_SISIMPERIALS_HARVEST: 10
        STR_IMPERIALGUARD_BASE: 20
        STR_ULTRAMARINE_BASEV2: 50
        STR_BLACKTEMPLAR_BASEV2: 50
        STR_SPACEWOLVES_BASEV2: 50
        STR_CRIMSONFIST_BASEV2: 50
        STR_SALAMANDER_BASEV2: 50
        STR_BLOODYROSE_BASEV2: 30
        STR_TAU_ORCAEXPEDITION: 5 #delayed onset
        STR_TAU_DEVILFISH_EXPEDITION: 5
      6:  # equal distribution for now
        STR_ALIEN_RESEARCH_HARD: 5
        STR_NURGLE_RESEARCH_HARD: 5
        STR_ALIEN_RESEARCH_TZEENTCH_HARD: 5
        STR_ALIEN_HARVEST_HARD: 5
        STR_NURGLE_HARVEST_HARD: 5
        STR_ALIEN_HARVEST_TZEENTCH_HARD: 5
        STR_ALIEN_ABDUCTION_HARD: 5
        STR_NURGLE_ABDUCTION_HARD: 5
        STR_ALIEN_ABDUCTION_TZEENTCH_HARD: 5
        STR_ALIEN_INFILTRATION_HARD: 5
        STR_NURGLE_INFILTRATION_HARD: 5
        STR_ALIEN_INFILTRATION_TZEENTCH_HARD: 5
        STR_IMPERIALS_ABDUCTION: 10
        STR_IMPERIALS_HARVEST: 10
        STR_SISIMPERIALS_ABDUCTION: 10
        STR_SISIMPERIALS_HARVEST: 10
        STR_IMPERIALGUARD_BASE: 5
        STR_ULTRAMARINE_BASEV2: 70
        STR_BLACKTEMPLAR_BASEV2: 70
        STR_SPACEWOLVES_BASEV2: 70
        STR_CRIMSONFIST_BASEV2: 70
        STR_SALAMANDER_BASEV2: 70
        STR_BLOODYROSE_BASEV2: 30
        STR_TAU_ORCAEXPEDITION: 5 #delayed onset
        STR_TAU_DEVILFISH_EXPEDITION: 5
    firstMonth: 1
    useTable: true
    researchTriggers:
      STR_HARDER_MISSIONS: true
      STR_SLAANESHPATH: true
  - type: warpStormBuildingHardCHAOSCCULT
    refNode: *STR_HARD_CHAOSMISSION_TABLESLAANESH
    firstMonth: 3
    lastMonth: 5
    executionOdds: 50
    useTable: true
  - type: warpStormRagingHardCHAOSCCULT
    refNode: *STR_HARD_CHAOSMISSION_TABLESLAANESH
    firstMonth: 6
    useTable: true

  - type: Slaaneshstrategy_MonthlyAdeptasMissions # Monthly script for sisters missions
    missionWeights: # TODO: ADD MORE MISSIONS
      0:
        STR_SLAANESHPATH_CATACOMBS: 20
        #STR_RESCUE_PDF_VALKYRIE_TAU: 40  # grounded valkyrie appears on radar, go to support to pick up some PDF, maybe an officer
      2:
        STR_CATACOMBS: 20        
      4:
        #STR_ALIEN_WAR_TAU: 50  # delays the WAR mission until month 5+
        #STR_CATACOMBS: 10
        #STR_ALIEN_ARTIFACT_TAU: 10
        #STR_RESCUE_PDF_VALKYRIE_TAU: 20
        STR_SUPPORT_PDF_ASSAULT: 20  # PDF assaulting chaos base of cult or traitor guard
    regionWeights:
      0:
        REGION_HULK_SITES: 100
    useTable: false
    firstMonth: 1
    executionOdds: 100
    startDelay: 15000  # 10k = 7 days
    researchTriggers:
      STR_DEFAULT_CAMPAIGN: false
      STR_SLAANESHPATH: true