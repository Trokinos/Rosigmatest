######################################################################################################
#                           THIS FILE USES THE FOLLOWING FORMAT
# 1: DROPOFF
# 2: ACCURACYSNAP
# 3: ACCURACYAUTO
# 4: ACCURACYAIMED
# 5: SNAPRANGE
# 6: AUTORANGE
# 7: AIMEDRANGE
# 8: TUSNAP
# 9: TUAUTO
# 10: TUAIMED
# 11: AUTOSHOTS
# 12: CONFSNAP, CONFAUTO, CONFAIMED
# 13: WEIGHT
# 14: TAGS & MISC ATTRIBUTES
#
# WEAPON GENERAL ATTRIBUTES ARE LOCATED IN WEAPONS.PLAYERSLAANESH.RUL
# PRICE, REQUIREMENT, & AVAILABILITY ATTRIBUTES ARE LOCATED IN ITEMREQUIREMENTS.PLAYERSLAANESH.RUL
#
###################################### TABLE OF CONTENTS #############################################
#
# 1: NON-BOLTER BALLISTIC WEAPONS
# 2: BOLTPISTOLS
# 3: LIGHT BOLTERS
# 4: MEDIUM & HEAVY BOLTERS
# 5: LAS WEAPONS
# 6: PLASMA WEAPONS
# 7: MELTA WEAPONS
# 8: GRENADES



items:

