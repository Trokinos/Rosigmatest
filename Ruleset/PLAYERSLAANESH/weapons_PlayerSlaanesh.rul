      name: STR_BURST_SNAP_SHOT
      arcing: false
      autoShots: 2
    confSnap:  # Double Shot
      ammoSlot: 0  # Bolter
      name: STR_SNAP_SHOT
      arcing: false
      shots: 1  # Double shot snap
    confAimed:  # Plasma spray gun
