  - type: STR_SLAANESHPATH_BOLTER_NAGA # Corrupted Elohim with direct-fire grenade launcher attachment.

    dropoff: 5
    autoRange: 9
    snapRange: 16  # DMR
    aimRange: 0

    accuracyAuto: 80
    accuracySnap: 90 # 5 less
    accuracyAimed: 50 # PLACEHOLDER
