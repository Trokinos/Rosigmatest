    requiresBuy:
      - STR_SLAANESHPATH
    dropoff: 5
    autoRange: 7 
    snapRange: 12 # -2 vs Cantus, Slaanesh weapon profile
    aimRange: 0

    accuracyAuto: 55
    accuracySnap: 85
    accuracyAimed: 0
    tuAuto: 30
    tuSnap: 20
    tuAimed: 0
    confSnap:
      name: STR_BURST_SNAP_SHOT
      shots: 2  # Double shot snap
    autoShots: 4 # foregrip
    size: 0.3
    costBuy: 5000
    costSell: 1500
    weight: 10
    bigSprite: 2006
    floorSprite: {mod: 40k, index: 1}
    handSprite: {mod: 40k, index: 1496}
    bulletSprite: {mod: 40k, index: 6}
    fireSound: 2137
    compatibleAmmo:
      - STR_CANTUS_BOLTER_AMMO
      - STR_CANTUS_BOLTER_AMMO_SLAAN
    battleType: 1
    twoHanded: true
    invWidth: 2
    invHeight: 3
    armor: 300
    bulletSpeed: 30
    attraction: 1
    listOrder: 10286
    tags:
      ITEM_RECOIL: 20
      ITEM_COLOR_CHANGES_WITH_AMMO: 15

  - type: STR_SLAANESHPATH_BOLTER_NAIAD  # Corrupted Adeptas bolter with a sonic projector.
    dropoff: 5
    autoRange: 7  # 4 Auto
    snapRange: 12  # Double Tap
    aimRange: 14  # Sonic projector

    accuracyAuto: 70
    accuracySnap: 80
    accuracyAimed: 60
    tuAuto: 40
    tuSnap: 25
    tuAimed: 35
    compatibleAmmo: # PLACEHOLDER
      - STR_RIFLE_CLIP
      - STR_RIFLE_CLIP_S
      - STR_RIFLE_CLIP_MC
      - STR_RIFLE_CLIP_AP
      - STR_RIFLE_CLIP_EX
    ammo: # PLACEHOLDER
      0:
        compatibleAmmo: [STR_RIFLE_CLIP_S, STR_RIFLE_CLIP, STR_RIFLE_CLIP_MC, STR_RIFLE_CLIP_AP, STR_RIFLE_CLIP_EX]
      1:
        compatibleAmmo: [STR_NAIAD_SONIC_SHRIEKER_CHARGE, STR_NAIAD_SONIC_SCREAMER_CHARGE]

    autoShots: 4
    confAuto:  # Bolter
      ammoSlot: 0  # Bolter
      name: STR_AUTOFIRE
      arcing: false
    confSnap:  # Double Shot
      ammoSlot: 0  # Bolter
      name: STR_BURST_SNAP_SHOT
      arcing: false
      shots: 2  # Double shot snap
    confAimed:  # Sonic projector
      ammoSlot: 1  # Sonic
      name: STR_SONIC_FIRE



  - type: AUX_CHIRURGEON_NEEDLER # LOOK AT ADEPTAS NEURAL WHIP FOR ALT FIRE IMPLEMENTATION
