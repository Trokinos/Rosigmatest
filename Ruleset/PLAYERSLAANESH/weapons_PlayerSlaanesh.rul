  - type: AUX_CHIRURGEON_NEEDLER # LOOK AT ADEPTAS NEURAL WHIP FOR ALT FIRE IMPLEMENTATION
    weight: 0
    dropoff: 6 # Very inaccurate beyond close range
    bigSprite: {mod: 40k, index: 228}
    floorSprite: {mod: 40k, index: 113}
    bulletSprite: 25
    fireSound: 2419  # silentshot
    hitSound: {mod: 40k, index: 101}  # stabhit
    hitAnimation: 2190  # purple juice
    handSprite: 3813
    power: 30
    tuSnap: 20
    tuAimed: 0
    snapRange: 7
    aimRange: 0
    damageBonus: # Not a sniper weapon unlike most other needlers. Gains a bonus from reactions.
      reactions: 0.1     
    damageType: 8  # acid
    damageAlter:  # Hallucinogenic, warp-tainted chems.
      ArmorEffectiveness: 0.5  # low power but high penetration
      ToArmorPre: 0.05  # precision weapon; minimal armor damage
      ToArmor: 0.05  # precision weapon; minimal armor damage
      ToHealth: 0.2
      ToMana: 0.9
      ToEnergy: 0.75  # Hallucinogenic cocktail
      ToStun: 1.5  # Hallucinogenic cocktail
      ToTime: 0.5  # higher than normal TU depletion
