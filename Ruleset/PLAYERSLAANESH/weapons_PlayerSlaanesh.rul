      firing: 0.75
      reactions: 0.25
    tuAimed: 0
    snapRange: 7
    aimRange: 0

    damageBonus: # Not a sniper weapon unlike most other needlers. Gains a bonus from reactions.
      reactions: 0.15
      firing: 0.15     
    damageType: 8  # acid
