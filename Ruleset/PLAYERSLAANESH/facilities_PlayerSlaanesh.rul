facilities:




  - type: STR_SLAANESH_SHRINE
    refundValue: 325000
    destroyedFacility: STR_CORRIDOR
    sickBayAbsoluteBonus: 0.0
    sickBayRelativeBonus: 1.0
    psiLabs: 10
    placeSound: {mod: 40k, index: 98}
    requiresBaseFunc: [BASE]
    requires:
      - STR_SLAANESHPATH_GATE
    spriteShape: 1
    spriteFacility: 36
    rightClickActionType: 5
    buildCost: 250000 # This building is meant to be cheap and provide passive money generation.
    maxAllowedPerBase: 1
    buildTime: 10
    monthlyCost: -100000
    provideBaseFunc: [ALTAR1]
    mapName: XBASE_49
    listOrder: 850

#  - type: STR_SLAANESHPRISON_TIER1
