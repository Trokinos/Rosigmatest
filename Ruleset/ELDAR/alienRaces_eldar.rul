  - id: STR_SLAANESH_CORRUPTED_GANGERS #gangers mixed in with slaanesh low level troops
    retaliationMissionWeights:
      0:
        STR_ALIEN_RETALIATION: 100
    retaliationAggression: -100
    membersRandom:
      - [STR_GANGERBASE_GOLIATH_AI] # 0 Commander
      - [STR_SLAANESH_GUARD_F, STR_SLAANESH_GUARD_M, STR_SECTOID_COMMANDER] # 1 Leader
      - [STR_GANGEROUSAI, STR_SECTOID_LEADER] # 2 Engineer
      - [STR_CHAOSCULT_SOLDIERM_LV1_AI, STR_CHAOSCULT_SOLDIERF_LV1_AI] # 3 Medic
      - [STR_GANGERBASE_SOLDIERF0_AI, STR_GANGERBASE_SOLDIERF1_AI, STR_GANGERBASE_SOLDIERF2_AI, STR_GANGERBASE_SOLDIERM0_AI, STR_GANGERBASE_SOLDIERM1_AI, STR_GANGERBASE_SOLDIERM0_AI] # 4 Navigator
      - [STR_GANGERBASE_SOLDIERF0_AI, STR_GANGERBASE_SOLDIERF1_AI, STR_GANGERBASE_SOLDIERF2_AI, STR_GANGERBASE_SOLDIERM0_AI, STR_GANGERBASE_SOLDIERM1_AI, STR_GANGERBASE_SOLDIERM0_AI, STR_CHAOSCULT_SOLDIERM_LV1_AI, STR_CHAOSCULT_SOLDIERF_LV1_AI] # 5 Soldier
      - [STR_GANGERBASE_SOLDIERF0_AI, STR_GANGERBASE_SOLDIERF1_AI, STR_GANGERBASE_SOLDIERF2_AI, STR_GANGERBASE_SOLDIERM0_AI, STR_GANGERBASE_SOLDIERM1_AI, STR_GANGERBASE_SOLDIERM0_AI] # 6 Hangers on
      - [STR_GANGERBASE_SOLDIERF0_AI, STR_GANGERBASE_SOLDIERF1_AI, STR_GANGERBASE_SOLDIERF2_AI, STR_GANGERBASE_SOLDIERM0_AI, STR_GANGERBASE_SOLDIERM1_AI, STR_GANGERBASE_SOLDIERM0_AI, STR_CHAOSCULT_OGRYN_AI] # 7 Big guy

  - id: STR_SLAANESH_PALACE_ELDARS_LV1 #mostly slaanesh low-med quality troops
    retaliationMissionWeights:
      0:
        STR_ALIEN_RETALIATION: 100
    retaliationAggression: -100
    membersRandom:
      - [STR_CHAOSCULT_PRIEST_LV4F_AI] # 0 Commander #
      - [STR_SLAANESH_SHARDSPEAKER] # 1 Leader
      - [STR_ALPHA_DAEMONETTE] # 2 Engineer
      - [STR_SLAANESH_SISTERASS] # 3 Medic
      - [STR_SLAANESH_GUARD_CARAPACE, STR_SLAANESH_CANTUS, STR_SLAANGOR_FIENDGOR] # 4 Navigator
      - [STR_SLAANESH_FBLESSED, STR_SLAANESH_FBLESSED_FALSE, STR_HERETIC_SISTER_SBLESSED, STR_HERETIC_SISTER_SBLESSED_LIE, STR_DIRE_DAEMONETTE, STR_SLAANESH_CULTIST_BIGM] # 5 Soldier
      - [STR_SLAANGOR_GOR, STR_SLAANGOR_UNGOR, STR_SLAANGOR_BRAYGOR] # 6 Hangers on
      - [STR_CHAOSCULT_SOLDIERM_LV1_AI, STR_CHAOSCULT_SOLDIERF_LV1_AI] # 7 Big guy

  - id: STR_SLAANESH_PALACE_ELDARS_LV2 #medium quality with heavy hitters.
    retaliationMissionWeights:
      0:
        STR_ALIEN_RETALIATION: 100
    retaliationAggression: -100
    membersRandom:
      - [STR_SLAANESH_CHOSEN] # 0 Commander
      - [STR_HAVOC_SLAANESH, STR_SLAANESH_CSM_CHAMPION] # 1 Leader
      - [STR_SLAANESH_MBLESSED, STR_SLAANESH_SOLDIER] # 2 Engineer
      - [STR_SLAANESH_CHOSENASS] # 3 Medic
      - [STR_SLAANESH_FBLESSED_FALSE, STR_SLAANESH_FBLESSED, STR_SLAANESH_SISTER_BLESSED_FALSE, STR_SLAANESH_SISTER_BLESSED_TRUE, STR_SLAANESH_SOLDIER] # 4 Navigator
      - [STR_SLAANESH_FBLESSED, STR_SLAANESH_FBLESSED_FALSE, STR_HERETIC_SISTER_SBLESSED, STR_HERETIC_SISTER_SBLESSED_LIE, STR_DIRE_DAEMONETTE, STR_SLAANESH_CULTIST_BIGM, STR_SLAANESH_SOLDIER] # 5 Soldier
      - [STR_SLAANESH_GUARD_F, STR_SLAANESH_GUARD_M, STR_SLAANESH_MUTANT] # 6 Hangers on
      - [STR_CHAOSCULT_GUARDFLAKM_AI, STR_CHAOSCULT_GUARDFLAKF_AI] # 7 Big guy
