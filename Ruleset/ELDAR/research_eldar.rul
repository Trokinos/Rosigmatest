###

research:
### core tech tree research
  - name: STR_ELDAR_SELECTED        # (Eldar selected)
    dependencies:
      - STR_GENERALLOCK

# Everyone has these by default.
  - name: STR_NOT_ELDAR_STRATEGY         # (Not Eldar and friends)

### The Eldar starting condition is
### STR_CHAPTER_PURITY: true # Disabled by going chaos
### STR_ARBITES: true

### the big strategy that allows to start an eldar campaign
  - name: STR_ELDAR_STRATEGY
    points: 0
    cost: 5
    dependencies:
      - STR_ARBITES
    reenables:
      - STR_CHAPTER_PURITY    # not all who wander are lost
    lookup: STR_CHOSEN_ELDAR_STRATEGY
    unlocks:
      - STR_GUARD_BARRACKS
      #- STR_SCIENTISTS_AND_ENGINEERS_AVAILABLE
      #- STR_PILOT_GUARDSMEN # TODO: understand how we want to manage Eldar pilots
      - STR_RECRUIT_ELDAR_T1
      #- STR_LASER_WEAPONS     # easiest way to activate heavy stubbers (???)
      #- STR_IMPERIAL_WEAPONS  # Flamer/Shotgun/Guard Laspistol/Guard Lasgun
      #- STR_GUARD_AND_ARBITES # easiest way to activate stub rifles
      #- STR_NOT_STEEL_LEGION_STRATEGY # needed to activate normal chimeras (???)
      #- STR_TAU_EMPIRE_GV
      #- STR_TAU_GUEVESA_GV
      #- STR_TAU_AUXILIARY_GV
      - STR_CHAPTER_PURITY
      #- STR_NOT_IMPERIUM
      #- STR_NOT_CHAOSCULT
      #- STR_NOT_THE_IMPERIAL_LAW
      #- STR_ENDGANGERSBASE    # Stop the onslaught of gang events
      #- STR_GENESTEALERS_INACTIVE # no genestealers
      #- STR_GSC_ARBITES_SPAWNED   # prevent GSC arbites spawn
      - STR_ELDAR_SELECTED
      - STR_ELDAR_ARMORY_EXAM # unlock all eldar armory codex
      - STR_ELDAR_ONLY # eldar weapon training
      #- STR_ELDAR_WEAPONS_ACQUISITION # Gets in high tier
      - STR_ELDAR_OUTPOST_BUILDING_RESEARCH
      - STR_ELDAR_BASE_BUILDING_RESEARCH
      - STR_ELDAR_CRAFT_RESEARCH
      # TEMP ADDITIONS for future campaign splitting
      - STR_ELDAR_ASURYANI_CAMPAING # TEMPORARY addition until there are multiple eldar campaigns
      #- STR_CHOSEN_ELDAR_STRATEGY
      - STR_FUSION_TECH_RESEARCH # Eldar Meltagun equivalent
      - STR_ELDAR_BONESINGING
      - STR_ELDAR_INACTIVE #no infighting
    disables:
      - STR_NOT_ELDAR_STRATEGY
      - STR_GENESTEALERS_ACTIVE
      - STR_CHAOS_PATH
      - STR_CHAOS_STRATEGY_ARBITES
      - STR_CHAOS_STRATEGY
      - STR_GREENEST_ORKZ
      - STR_TAU_GUEVESA_STRATEGY_GV
      - STR_SLAANESHPATH
      #- STR_PSI_LAB # we need to develop a proper psyker chamber
      - STR_PSI_AMP # eldar won't get normal tome of the mind and other stuff
      - STR_COMBAT_SERVITOR_PROGRAM # eldar don't use such barbaric tech
      - STR_THE_MARTIAN_SOLUTION  # More like a Monke problem! Eldar care about Slaneesh
      - STR_DEFAULT_CAMPAIGN
      - STR_DIFFICULTY_OPTIONS    # does not have harder missions
    spawnedEvent: STR_ELDAR_ASURYANI_CAMPAING_START # Temporary untill we split the strategy?

  - name: STR_CHOSEN_ELDAR_STRATEGY #research lookup for eldar chosen
    cost: 0
    points: 0
    dependencies:
      - STR_GENERALLOCK

  - name: STR_ELDAR_ASURYANI_CAMPAING         # (Asuryani campaign)
    cost: 0
    points: 0
    dependencies:
      - STR_GENERALLOCK
    #spawnedEvent: STR_ELDAR_ASURYANI_CAMPAING_START

  - name: STR_ELDAR_ASURYANI_CAMPAING_LETTER_RECEIVED         # Asuryani campaign LORE, to be granted via the event that gives goodies
    cost: 0
    points: 0
    dependencies:
      - STR_GENERALLOCK

  - name: STR_ELDAR_BONESINGING # Required for eldar equipment manufacture
    cost: 0
    points: 0
    dependencies:
      - STR_GENERALLOCK

  - name: STR_ELDAR_WEAPONS_ACQUISITION # Required for Buying
    cost: 0
    points: 0
    dependencies:
      - STR_GENERALLOCK

  - name: STR_ELDAR_ARMOR_ACQUISITION # Required for Buying
    cost: 0
    points: 0
    dependencies:
      - STR_GENERALLOCK

  - name: STR_ELDAR_CRAFT_RESEARCH
    cost: 0
    points: 0
    dependencies:
      - STR_GENERALLOCK

  - name: STR_ELDAR_OUTPOST_BUILDING_RESEARCH #allow you to build outpost building for eldar
    cost: 0
    points: 0
    dependencies:
      - STR_GENERALLOCK

  - name: STR_ELDAR_BASE_BUILDING_RESEARCH #allow you to build base buildings for eldar
    cost: 0
    points: 0
    dependencies:
      - STR_GENERALLOCK

  - name: STR_RECRUIT_ELDAR_T1
    cost: 0
    points: 0
    dependencies:
      - STR_GENERALLOCK

  - name: STR_RECRUIT_ELDAR_OUTCAST # recruit eldar outcast
    cost: 100
    points: 0
    dependencies:
      - STR_ELDAR_STRATEGY

  - name: STR_ELDAR_HWP_RESEARCH
    cost: 100
    points: 0
    dependencies:
      - STR_ELDAR_STRATEGY
    getOneFree:
      - STR_ELDAR_HWP_SHURIKENCANNON_ARMOR_RESEARCH
#------------------------------------------------------------------
  # ELDAR ALLIANCE ONLY
  # ELDAR ALLIANCE MIDTIER Change after doin Midtier aspect warrior missions
  - name: STR_ELDAR_ALLIANCE_ASPECT_MIDTIER
    cost: 0
    points: 0
    unlocks:
      - STR_ELDAR_DIRE_AVENGER_RESEARCH
      - STR_ELDAR_FIREDRAGON_RESEARCH
      - STR_ELDAR_SCORPION_RESEARCH
      - STR_ELDAR_BANSHEE_RESEARCH
      - STR_ELDAR_HAWK_RESEARCH
      - STR_ELDAR_SPIDER_RESEARCH
      - STR_ELDAR_REAPER_RESEARCH
    dependencies:
      - STR_GENERALLOCK

  - name: STR_ELDAR_ALLIANCE_ASPECT_HIGHTIER
    cost: 0
    points: 0
    unlocks:
      - STR_ELDAR_DIRE_AVENGER_EXARCH_RESEARCH
      - STR_ELDAR_FIREDRAGON_EXARCH_RESEARCH
      - STR_ELDAR_SCORPION_EXARCH_RESEARCH
      - STR_ELDAR_BANSHEE_EXARCH_RESEARCH
      - STR_ELDAR_HAWK_EXARCH_RESEARCH
      - STR_ELDAR_SPIDER_EXARCH_RESEARCH
      - STR_ELDAR_REAPER_EXARCH_RESEARCH
    dependencies:
      - STR_GENERALLOCK

#------------------------------------------------------------------
  ### Eldar Alliance imports
  - delete: STR_ELDAR_SHIELD
  - name: STR_ELDAR_SHIELD  # Eldar Personal Shield
    cost: 200
    points: 50
    dependencies:
      - STR_ELDAR_ASURYANI_CAMPAING_T3
      - STR_HIGHTIER_PREREQ

 ### Early Game Imperium Pact
  - name: STR_LET_MONKEIGH_ORKEAD_FIGHT # Let them deal with each other.
    cost: 100
    points: 200 # Popular with the Eldar
    dependencies:
      - STR_ELDAR_STRATEGY
    disables: [STR_MONKEIGH_PACT]
    # spawnedEvent: Some reward to balance the alliance choice, doesnt have to be a lot

  - name: STR_MONKEIGH_PACT # Allows recruitment of Imperial meatshield unit
    cost: 100
    points: -200 # unpopular with the Eldar
    disables: [STR_LET_MONKEIGH_ORKEAD_FIGHT]
    dependencies:
      - STR_ELDAR_STRATEGY
    # spawnedEvent: MONKEIGH ALLIES STARTING PACKAGE EVENT

  - name: STR_MONKEIGH_RETALIATION # ACTIVATES RETALIATION EVENT
    cost: 0
    points: 0
    dependencies:
      - STR_MONKEIGH_PACT
      - STR_ELDAR_ASPECT_RESEARCH #   research triggers ahead of  STR_MONKEIGH_PACT_UNNECESSARY
    # spawnedEvent: MONKEIGH RETALIATION EVENT HERE

  - name: STR_MONKEIGH_PACT_UNNECESSARY
    cost: 0
    points: 0
    dependencies:
      - STR_ELDAR_ASPECT_RESEARCH
      - STR_ELDAR_STRATEGY
    disables:
      - STR_MONKEIGH_PACT # Remove access to Imperial recruits once Aspect Warriors are unlocked
      - STR_LET_MONKEIGH_ORKEAD_FIGHT # If the player ignores both choices.

  - name: STR_FUSION_TECH_RESEARCH # Eldar Meltagun Equivalent
    cost: 150
    points: 0
    dependencies:
      #- STR_MELTAGUN_TECH
      - STR_ELDAR_WEAPONS_ACQUISITION

#------------------------------------------------------------------
# TIER 2
  - name: STR_ELDAR_ASURYANI_CAMPAING_T2
    points: 0
    cost: 200
    dependencies:
      - STR_ELDAR_ASURYANI_CAMPAING
      #- STR_MELTAGUN_TECH
      - STR_FUSION_TECH_RESEARCH
      - STR_ALIEN_ALLOYS
      - STR_MOTION_SCANNER
    unlocks:
      - STR_MIDTIER_PREREQ
      - STR_ELDAR_REQUEST_ADDITIONAL_MIDTIER_REINFORCEMENTS
      - STR_ELDAR_EMERGENCY_REINFORCEMENT_REQUEST_RESEARCH # Allows Buying the Request Item
    spawnedEvent: STR_ELDAR_MIDTIER_REINFORCEMENTS

  - name: STR_ELDAR_REQUEST_ADDITIONAL_MIDTIER_REINFORCEMENTS
    points: -10000 # Guarantee Negative score for the month
    cost: 0
    needItem: true
    neededItem: STR_ELDAR_EMERGENCY_REINFORCEMENT_REQUEST
    destroyItem: true
    dependencies:
      - STR_GENERALLOCK
    spawnedEvent: STR_ELDAR_ADDITIONAL_REINFORCEMENTS

  - name: STR_ELDAR_ASPECT_RESEARCH  # Aspect Warrior Promotions
    cost: 100
    dependencies:
      - STR_RECRUIT_ELDAR_T1
      - STR_MIDTIER_PREREQ

  - name: STR_ELDAR_DIRE_AVENGER_RESEARCH #dire avenger will always be the entry point. this must not have a cost
    cost: 0
    dependencies:
      - STR_ELDAR_ASPECT_RESEARCH

  - name: STR_ELDAR_SCORPION_RESEARCH
    cost: 150
    points: 0
    dependencies:
      - STR_ELDAR_ASPECT_RESEARCH

  - name: STR_ELDAR_REAPER_RESEARCH
    cost: 200
