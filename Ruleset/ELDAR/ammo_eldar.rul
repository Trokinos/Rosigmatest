  - type: STR_ELDAR_HWP_SCATTERLASER_AMMO
    invHeight: 0
    invWidth: 0
    battleType: 2
    hitSound: 3986
    hitAnimation: 2220
    bulletSprite: {mod: 40k, index: 22}
    vaporColorSurface: 4  # red laser
    vaporDensitySurface: 2
    vaporProbabilitySurface: 100
    bulletSpeed: 10
    explosionSpeed: 3
    scripts:
      vaporParticleAmmo: |
        # noting
        set particle_lifetime 1;
        set subvoxel_drift 0;
        return;
    clipSize: -1
    recover: false
