  - &LONG_RIFLE_MAG_TEMPLATE
    type: STR_RANGER_LONG_RIFLE_MAG #TEMPORARY copied STR_TAU_PULSE_MAG
    categories: [STR_CAT_ELDAR, STR_CAT_SNIPER]
    requires:
      - STR_ELDAR_ONLY # eldar weapon training
    requiresBuy:
      - STR_ELDAR_WEAPONS_ACQUISITION
      - STR_RECRUIT_ELDAR_OUTCAST
    requiresBuyBaseFunc: [ELDAROUT]
    size: 0.2
    weight: 2 #light weight
    invHeight: 1
    invWidth: 2
    bigSprite: 4859
    floorSprite: 4859
    handSprite: 4874
    bulletSprite: {mod: 40k, index: 12}
    hitSound: {mod: 40k, index: 19}
    hitAnimation: {mod: 40k, index: 100}
    vaporColorSurface: {mod: 40k, index: 2}
    vaporDensitySurface: 3
    vaporProbabilitySurface: 50
    costBuy: 0 # 4000 Rangers provide their own Ammo
    costSell: 0 # 1000
    scripts:
      vaporParticleAmmo: |
        # noting
        set particle_lifetime 20;
        set subvoxel_drift 3;
        return;
    explosionSpeed: 10
    bulletSpeed: 25
    battleType: 2
    clipSize: 20
    power: 70
    damageType: 1 # was 5
    damageAlter:
      RandomType: 2
      ToArmorPre: 0.1 # minimal damage to armor
      ToArmor: 0
      ArmorEffectiveness: 0.8 # Precise shots find gaps in armor
      ToHealth: 1
      IgnoreSelfDestruct: true
      IgnoreOverKill: true
    listOrder: 16620

