    dropoff: 6
    costBuy: 6000
    costSell: 2750
    bigSprite: {mod: 40k, index: 391}
    floorSprite: {mod: 40k, index: 243}
    handSprite: {mod: 40k, index: 832}
    bulletSprite: {mod: 40k, index: 20}
    fireSound: [{mod: 40k, index: 839}, {mod: 40k, index: 840}, {mod: 40k, index: 841}]
    compatibleAmmo:
      - STR_SHURIKEN_CLIP
    accuracySnap: 80
    accuracyAuto: 66
    battleType: 1
    twoHanded: true
    invWidth: 2
    invHeight: 3
    armor: 200
    autoShots: 9
    bulletSpeed: 30
    attraction: 5
    snapRange: 12
    autoRange: 9
    confSnap:
      shots: 3
      name: STR_SHURIKEN_WEAPON_SNAPSHOT
      followProjectiles: false
    confAuto:
      name: STR_SHURIKEN_WEAPON_AUTOSHOT
      followProjectiles: false
    experienceTrainingMode: 5
    tuSnap: 21
    tuAuto: 32
    flatRate: true
    listOrder: 16100

