  - type: STR_SHOTGUN_MONKEIGH #
    ufopediaType: STR_SHOTGUN
    categories: [STR_CAT_SHOTGUN, STR_CAT_SCOUT]
    size: 0.2
    costBuy: 0 # Can't be bought
    weight: 7
    bigSprite: {mod: 40k, index: 235}
    floorSprite: {mod: 40k, index: 118}
    handSprite: {mod: 40k, index: 328}
    bulletSprite: {mod: 40k, index: 2}
    fireSound: {mod: 40k, index: 755}
    fixedWeapon: true     # Mercenary's bring their own Weapon
    fixedWeaponShow: true
    recover: false # Fixed to armor
    compatibleAmmo:
      - STR_SHOTGUN_SHELLS
      - STR_SHOTGUN_SHELLS_AP
      - STR_SHOTGUN_SHELLS_INC
    battleType: 1
    twoHanded: true
    invWidth: 1
    invHeight: 3
    listOrder: 16099
    dropoff: 6
    autoRange: 0
    snapRange: 12
    aimRange: 0
    accuracyAuto: 0
    accuracySnap: 65  # 40k 66  # ROSIGMA 1.06Beta2 75
    accuracyAimed: 0  # 40k 80  # ROSIGMA 1.06Beta2 95
    tuAuto: 0
    tuSnap: 20  # 40k 25  # ROSIGMA 1.06Beta2 20
    tuAimed: 0  # 40k 33  # ROSIGMA 1.06Beta2 35  # get rid of aimed
    #tags:
     # REACTION_MULTIPLIER: 150

#--- ELDAR.WEAPONS ---
  - delete: STR_CATAPULT
  - &ELDAR_SHURIKEN_WEAPON_TEMPLATE
    type: STR_CATAPULT
    requires:
