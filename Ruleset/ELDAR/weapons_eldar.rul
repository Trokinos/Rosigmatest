      firing: 0.5
      reactions: 0.7 # makes similar accuracy at lowest reactions, gives avengers extra accuracy at max cap
    invWidth: 2
    invHeight: 3
    confSnap:
      shots: 4
      name: STR_SHURIKEN_WEAPON_SNAPSHOT
      followProjectiles: false
    confAuto:
      name: STR_SHURIKEN_WEAPON_AUTOSHOT
      followProjectiles: false
