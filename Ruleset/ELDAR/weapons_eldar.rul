  - type: STR_HAWK_GRENADE_PACK # Functions as a short ranged explosive launcher
    costBuy: 0 # Cannot be bought
    recover: false
    fixedWeapon: true
    fixedWeaponShow: true
    twoHanded: false
    defaultInventorySlot: STR_BELT
    defaultInvSlotX: 2
    invWidth: 2
    invHeight: 2
    bigSprite: 4929 #does not show technically
    bulletSprite: {mod: 40k, index: 2}
    fireSound: [1908, 1909, 1910]
    hitAnimation: 2220 # No ANIMATION 150=Teleport hit original={mod: 40k, index: 26}
    battleType: 1
    accuracySnap: 40
    tuLoad: 33 # Slow to load, fast to fire
    tuSnap: 5 # Fast release, very little aiming needed
    snapRange: 0
    maxRange: 2 # Drops grenades vertically
    confSnap:
      name: STR_SKILL_HAWK_GRENADE_DROP
    experienceTrainingMode: 7 # train throwing
    arcingShot: true
    noLOSAccuracyPenalty: 75  # indirect fire weapon
    compatibleAmmo:
      - STR_HAWK_SUNBURST_GRENADES
      - STR_HAWK_STARSHOT_GRENADES
      - STR_HAWK_HAYWIRE_GRENADES
      - STR_HAWK_PLASMA_GRENADES
      - STR_HAWK_FUSION_GRENADES
    scripts:
      selectItemSprite:
        var ptr BattleItem ammoItem;
        var int ammoMax;
        var int ammoCurrent;
        var ptr RuleItem ammoRuleset;
        var int skipBigobs;
        var int ammoDiff;

        item.getAmmoItem ammoItem;
        ammoItem.getRuleItem ammoRuleset;
        ammoRuleset.getTag skipBigobs Tag.ITEM_AMMO_SKIP_BIGOBS;

        if and gt skipBigobs 0 eq blit_part blit_item_big;
          add sprite_index skipBigobs;
        end;

        item.getAmmoItem ammoItem;
        ammoItem.getAmmoQuantity ammoCurrent;
        ammoItem.getAmmoQuantityMax ammoMax;

        set ammoDiff ammoMax;
        sub ammoDiff ammoCurrent;
        if gt ammoDiff 0;
          sub sprite_index ammoDiff;
        end;

        return sprite_index;

