### Bases #BASE#
### used to constantly generate bases and not leave the world empty on top of warpstorm script
  # Default Loyalist
  - type: newTraditionalBasesEarly_Eldar
    missionWeights:
      0:
        STR_CULTIST_BASE: 33
        STR_TRAITOR_GUARD_BASE: 33
        STR_ORK_BASE: 33
        STR_TS_GANGER_BASE_START_ELDAR: 33
        STR_IMPERIALGUARD_BASEV0: 33
        STR_ULTRAMARINE_BASEV0: 11
        STR_FIERYHEART_BASEV0: 22
        STR_BLOODYROSE_BASEV0: 22
    firstMonth: 1
    lastMonth: 2
    startDelay: 120
    randomDelay: 20160 # Up to 2 weeks random delay
    executionOdds: 70
    researchTriggers:
      STR_DEFAULT_CAMPAIGN: true
      STR_NOT_BLACKTEMPLARS: true

  - type: newTraditionalBasesLater_Eldar
    missionWeights:
      0:
        STR_CULTIST_BASE: 33
        STR_TRAITOR_GUARD_BASE: 33
        STR_SLAANESH_BASE: 44
        STR_IMPERIALGUARD_BASE: 33
        STR_ORK_BASE: 22
        STR_BLOODYROSE_BASE: 5
        STR_FIERYHEART_BASE: 5
        STR_ULTRAMARINE_BASE: 5
        STR_BLACKTEMPLAR_BASE: 5
        STR_SPACEWOLVES_BASE: 5
        STR_CRIMSONFIST_BASE: 5
        STR_SALAMANDER_BASE: 5
    firstMonth: 3
    startDelay: 120
    randomDelay: 20160 # Up to 2 weeks random delay
    executionOdds: 100
    researchTriggers:
      STR_DEFAULT_CAMPAIGN: true
      STR_NOT_BLACKTEMPLARS: true

  - type: newTraditionalBasesExtra_Eldar
    missionWeights:
      0:
        STR_CULTIST_BASE: 33
        STR_TRAITOR_GUARD_BASE: 33
        STR_ORK_BASE: 33
        # lower chances of harder races
        STR_NECRON_BASE: 5 #REMOVE this entirely avoid submodding in base40Ks entry
        STR_ULTRAMARINE_BASEV0: 5
        STR_BLACKTEMPLAR_BASEV0: 5
        STR_SPACEWOLVES_BASEV0: 5
        STR_CRIMSONFIST_BASEV0: 5
        STR_SALAMANDER_BASEV0: 5
    firstMonth: 6
    startDelay: 120
    randomDelay: 20160 # Up to 2 weeks random delay
    executionOdds: 70
    researchTriggers:
      STR_DEFAULT_CAMPAIGN: true
      STR_NOT_WORDBEARERS: true
      STR_NOT_BLACKTEMPLARS: true