missionScripts:
  - type: STR_SLAANESH_BASE_ELDAR
    missionWeights:
      0:
        STR_SLAANESH_BASE_ELDAR: 100
    useTable: false
    firstMonth: 3 # April or later
    executionOdds: 100
    startDelay: 300
    maxRuns: 1
    varName: Eldar_Slaanesh_Palace_Assault
    researchTriggers:
      STR_ELDAR_ASURYANI_CAMPAING_T2: true
      STR_ELDAR_PSYKER_RESEARCH: true

# Space hulk scripts
  - type: SpaceHulkEldar
    missionWeights:
      # 0 is just for safety
      0:
        STR_ALIEN_ARTIFACT_ELDAR: 100
    regionWeights:
      0:
        REGION_HULK_SITES: 100
    varName: hulk
    useTable: false
    firstMonth: 1 #from February onward can spawn
    executionOdds: 30
    startDelay: 10000
    researchTriggers:
      STR_DEFAULT_CAMPAIGN: false
      STR_ELDAR_STRATEGY: true

  - type: HULKER_Eldar
    missionWeights:
      0:
        STR_ALIENER_ARTIFACT_ELDAR: 100
    regionWeights:
      0:
        REGION_HULK_SITES: 100
    researchTriggers:
      STR_DEFAULT_CAMPAIGN: false
      STR_ELDAR_STRATEGY: true
      STR_WARPED_VAULT: true
    firstMonth: 0
    startDelay: 4320  # 3 days
    randomDelay: 4320  # additional random 0 to 3 days
    useTable: false
    maxRuns: 1
    varName: HULKER_Eldar

### Normal warp storm content
### Used to have active missions even when no events trigger
### More Slaanesh and Tzeentch weighting (same as Tau strategy)
  - &STR_NORMAL_MISSION_TABLE_ELDAR
    type: warpStorm_ELDAR
    missionWeights:
      0:
        STR_ALIEN_RESEARCH: 33
        STR_ALIEN_RESEARCH_TZEENTCH: 20
        STR_NURGLE_RESEARCH: 11
        STR_ALIEN_HARVEST: 33
        STR_NURGLE_HARVEST: 11
        STR_ALIEN_HARVEST_TZEENTCH: 8 # rare
        STR_SLAANESH_HARVEST: 8 # rare
        STR_ALIEN_ABDUCTION: 33
        STR_NURGLE_ABDUCTION: 11
        STR_ALIEN_ABDUCTION_TZEENTCH: 8
        STR_SLAANESH_ABDUCTION: 66
        STR_ALIEN_INFILTRATION: 33
        STR_NURGLE_INFILTRATION: 11
        STR_ALIEN_INFILTRATION_SLAANESH: 66
        STR_ALIEN_INFILTRATION_TZEENTCH: 11
        # STR_ALIEN_BASE_SCALING_GV: 11
        ### Alien bases lists are balanced toward SM
        #STR_ALIEN_BASE: 33
        #STR_NURGLE_BASE: 11
        #STR_SLAANESH_BASE: 11
        #STR_TZEENTCH_BASE: 11
        STR_FIERYHEART_BASEV0: 10
        STR_IMPERIALS_ABDUCTION: 10
        STR_IMPERIALS_HARVEST: 10
        STR_SISIMPERIALS_ABDUCTION: 10
        STR_SISIMPERIALS_HARVEST: 10
        STR_IMPERIALGUARD_BASEV0: 25
        # STR_ULTRAMARINE_BASEV0: 25
        # STR_BLACKTEMPLAR_BASEV0: 25
        # STR_SPACEWOLVES_BASEV0: 25
        # STR_CRIMSONFIST_BASEV0: 25
        # STR_SALAMANDER_BASEV0: 25
      2:
        STR_ALIEN_RESEARCH: 33
        STR_ALIEN_RESEARCH_TZEENTCH: 20
        STR_NURGLE_RESEARCH: 11
        STR_ALIEN_HARVEST: 33
        STR_NURGLE_HARVEST: 11
        STR_ALIEN_HARVEST_TZEENTCH: 8 # rare
        STR_SLAANESH_HARVEST: 8 # rare
        STR_ALIEN_ABDUCTION: 33
        STR_NURGLE_ABDUCTION: 11
        STR_ALIEN_ABDUCTION_TZEENTCH: 8
        STR_SLAANESH_ABDUCTION: 66
        STR_ALIEN_INFILTRATION: 33
        STR_NURGLE_INFILTRATION: 11
        STR_ALIEN_INFILTRATION_SLAANESH: 66
        STR_ALIEN_INFILTRATION_TZEENTCH: 11
        # STR_ALIEN_BASE_SCALING_GV: 11
        STR_ALIEN_BASE: 33
        STR_NURGLE_BASE: 11
        STR_SLAANESH_BASE: 33
        STR_TZEENTCH_BASE: 11
        STR_IMPERIALS_ABDUCTION: 10
        STR_IMPERIALS_HARVEST: 10
        STR_SISIMPERIALS_ABDUCTION: 10
        STR_SISIMPERIALS_HARVEST: 10
        STR_IMPERIALGUARD_BASE: 5
        STR_FIERYHEART_BASE: 10
        STR_BLOODYROSE_BASE: 10
        STR_ULTRAMARINE_BASEV0: 5
        STR_BLACKTEMPLAR_BASEV0: 5
        STR_SPACEWOLVES_BASEV0: 5
        STR_CRIMSONFIST_BASEV0: 5
        STR_SALAMANDER_BASEV0: 5
        STR_ULTRAMARINE_BASE: 20
        STR_BLACKTEMPLAR_BASE: 20
        STR_SPACEWOLVES_BASE: 20
        STR_CRIMSONFIST_BASE: 20
        STR_SALAMANDER_BASE: 20
        STR_TAU_ORCAEXPEDITION: 30
        STR_TAU_DEVILFISH_EXPEDITION: 30
    researchTriggers:
      STR_DEFAULT_CAMPAIGN: false
      STR_HARDER_MISSIONS: false
      STR_ELDAR_STRATEGY: true
    firstMonth: 1

  # do the game spawn extra missions from months 3 to 5? (50% chances, as normal)
  - type: warpStormBuilding_ELDAR
    refNode: *STR_NORMAL_MISSION_TABLE_ELDAR
    firstMonth: 3
    lastMonth: 5
    executionOdds: 50

  - type: warpStormRaging_ELDAR
    refNode: *STR_NORMAL_MISSION_TABLE_ELDAR
    firstMonth: 6

