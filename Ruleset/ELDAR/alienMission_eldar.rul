  - type: STR_TS_CULTIST_BASE_START_ELDAR
    retaliationOdds: 0
    raceWeights:
      0:
        STR_SLAANESH_CULT_EARLY: 100 # todo: add slaanesh cultist variant list for eldars mixing cultist and eldars
    operationBaseType: STR_CULTIST_BASE_START
    siteType: STR_CULTIST_BASE_START
    operationType: 3 # Only creates a new base if the region doesn't have one
    operationSpawnZone: 4
    objective: 2
    points: 0

  - type: STR_TS_GANGER_BASE_START_ELDAR
