alienDeployments:

    # month 0 ganger base for chaos cult

  - type: STR_GANGER_BASE_CHAOSCORRUPTED
    markerIcon: 54
    #baseSelfDestructCode: STR_NOT_CHAOSCULT #STR_THE_IMPERIAL_LAW_STRATEGY
    terrains:
      - MUNDAINDUSTRIALURBANDIO
      #- CULTIST_TEMPLE
    script: MUNDAINDUSTRIALURBANDIO
    alienBase: true
    objectiveType: 100
    objectiveComplete: [STR_GANGER_BASE_DESTROYED, 250]
    objectivePopup: STR_GANGER_BASE_KILLED
    data:
      - alienRank: 0
        lowQty: 1
        highQty: 2
        dQty: 0
        percentageOutsideUfo: 0
        itemSets: &emptyItemSets [[], [], []]
      - alienRank: 1
        lowQty: 2
        highQty: 4
        dQty: 0
        percentageOutsideUfo: 50
        itemSets: *emptyItemSets
      - alienRank: 2
        lowQty: 2
        highQty: 4
        dQty: 0
        percentageOutsideUfo: 50
        itemSets: *emptyItemSets
      - alienRank: 3
        lowQty: 3
        highQty: 6
        dQty: 0
        percentageOutsideUfo: 75
        itemSets: *emptyItemSets
      - alienRank: 4
        lowQty: 3
        highQty: 3
        dQty: 0
        percentageOutsideUfo: 75
        itemSets: *emptyItemSets
      - alienRank: 5
        lowQty: 3
        highQty: 6
        dQty: 0
        percentageOutsideUfo: 75
        itemSets: *emptyItemSets
      - alienRank: 6
        lowQty: 3
        highQty: 3
        dQty: 0
        percentageOutsideUfo: 75
        itemSets: *emptyItemSets
      - alienRank: 7
        lowQty: 3
        highQty: 6
        dQty: 0
        percentageOutsideUfo: 75
        itemSets: *emptyItemSets
    briefing:
      cutscene: CULTBASE
      music: gmstory2
      title: STR_GANGER_BASE_ASSAULT
      textOffset: -16
      background: GANGERBASE.SCR
      showTarget: false
      desc: STR_GANGER_BASE_CHAOSCORRUPTED_ASSAULT_BRIEFING
    missionBountyItem: STR_KILLPOINT_TOKEN
    missionBountyItemCount: 100
    markerName: STR_GANGER_BASE_SITE
    genMissionRaceFromAlienBase: true
    genMission:
      STR_GANGER_INFILTRATION_ELDAR: 20 #rewards 5 eldar civilian
      STR_RIOT_ELDAR: 20 # riot inside friendly mon'key settlement
      STR_RIOT_ELDAR_ALTERNATE: 20 # riot inside friendly mon'key settlement
      STR_GANGERSCITYCONVOYDEF: 20  # to clone to set it as interception of gangers convoy. may reward SOME eldar civilian
      STR_GANGERSCITYCONVOYALT: 20 # to clone to set it as interception of gangers convoy. may reward SOME eldar civilian
      STR_TS_GANGER_BASE_START_ELDAR: 8
    genMissionFreq: 3
    genMissionLimit: 10000
    width: 50
    length: 50
    height: 12
    points: 0
    #unlockedResearch: STR_ENDGANGERSBASE

