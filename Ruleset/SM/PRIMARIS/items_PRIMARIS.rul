items:
  - type: STR_MKX_BIKE_ARMOR                #5459
    requires:
      - STR_PRIMARIS
      - STR_MARINES_STRATEGY
      - STR_CHAPTER_PURITY
    size: 2
    requiresBuyBaseFunc: [IMPERIUM]
    costBuy: 300000
    costSell: 140000
    transferTime: 50
    listOrder: 5459
    ufopediaType: STR_MKX_BIKE_UC

  # support AI grenade spawner for vehicle support

  - type: STR_PRIMARISBIKER_SPAWNER
    spawnUnit: STR_PRIMARIS_BIKER_AI
    spawnUnitChance: 100
    spawnUnitFaction: 0
    invWidth: 0
    invHeight: 0
    battleType: 4
    armor: 255
    recover: false
    hitAnimation: {mod: 40k, index: 150}
    hitSound: {mod: 40k, index: 788}
    hiddenOnMinimap: true


  - type: STR_PRIMARISDREAD_SPAWNER
    spawnUnit: STR_UMDREAD_AI  # for now oldmarine UM dread until a primaris dreadnought is made
    spawnUnitChance: 100
    spawnUnitFaction: 0
    invWidth: 0
    invHeight: 0
    battleType: 4
    armor: 255
    recover: false
    hitAnimation: {mod: 40k, index: 150}
    hitSound: {mod: 40k, index: 788}
    hiddenOnMinimap: true