  - delete: STR_VALKYRIE  # to make sure it's not dependant of 40K in case the blocker is defeated by submodding oddities

  - type: STR_VALKYRIE
    # ported from 40K due to the original having been deleted so there's no missing entries
    requiresBuyBaseFunc: [HANGAR]
    # marker: {mod: 40k, index:36}  # FIXME this syntax is not supported
    sprite: 1922
    fuelMax: 1800
    speedMax: 600
    accel: 2
    weapons: 3          # weapon number increased to 3.
    weaponTypes:        # definition of allowed weapon types in craft. Max 4 different types per slot.
      - 0               # slot 1 accepts weapons with type 0. This is default.
      - 0               # slot 2 accepts weapons with type 0.
      - [4, 5, 13]      # slot 3 accepts weapons with type 4, 5 and 13.
    weaponStrings:
      - STR_WEAPON_ONE
      - STR_WEAPON_TWO
      - STR_WEAPON_THREE
    pilots: 2
    costBuy: 600000
    costRent: 400000  # TIER I
    costSell: 400000
    refuelRate: 200
    transferTime: 96
    score: 300
    listOrder: 210
    spacecraft: true
    # end ported from 40k
    # ported from other alertsounds_disable in case the deletion may break things
    takeoffSound: -1
    selectSound: -1
    # end of port from other alertsounds_disable
    craftInventoryTile: [4, 10, 0]
    requires:
      - STR_STRATIG_DONE  # to make sure it is only available AFTER choosing an IG strategy
      - STR_GUARD_AND_ARBITES
      - STR_NOT_STEEL_LEGION_STRATEGY
      - STR_NOT_VALHALLAN_STRATEGY
      - STR_NOT_CHAOSCULT
