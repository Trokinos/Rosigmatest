#CF
  #Conflagrators are close range hand flamer specialists. Should have FNP and very high fire resistance.

  - type: STR_ECCLESIARCHY_CONFLAGRATOR_AI
    race: STR_ECCLESIARCHY_SANCTIFIERS
    liveAlien: STR_FRATERIS_MILITIA_AI # Temporary placeholder
    stats:
      tu: 65
      stamina: 65
      health: 55 # Much tougher than a frateris mook.
      bravery: 80
      reactions: 40
      firing: 50 # Decent aim, but uses short-range weapons.
      throwing: 40
      strength: 35
      psiStrength: 5
      psiSkill: 0
      melee: 45
    armor: STR_ECCLESIARCHY_CONFLAGRATOR_ARMOR
    standHeight: 21
    kneelHeight: 14
    value: 10
    intelligence: 3
    aggression: 6
    energyRecovery: 30
    deathSound: [{mod: 40k, index: 385}, {mod: 40k, index: 387}]
    psiWeapon: STR_NONE
    weightedBuiltInWeaponSets:
      -
        ECCLESIARCHY_CONFLAGRATOR_T0_SET1: 50 # Akimbo hand flamers
